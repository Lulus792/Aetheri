* text=auto
*.md text eol=lf
*.json text eol=lf
*.lock text eol=lf
*.sql text eol=lf
*.xml text eol=lf
*.py text eol=lf
*.c text eol=lf
*.h text eol=lf
*.cil text eol=lf
*.conf text eol=lf
*.desktop text eol=lf
# Unified diffs contain literal context prefixes before blank lines and tabs.
*.patch text eol=lf whitespace=-blank-at-eol,-space-before-tab
*.in text eol=lf
*.txt text eol=lf
LICENSE text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

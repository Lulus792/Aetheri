[Unit]
Description=Aetheri WLAN control for Settings
AssertSecurity=selinux
Requires=dbus.service systemd-logind.service
After=dbus.service systemd-logind.service

[Service]
Type=dbus
BusName=org.aetheri.Wlan1
ExecStart=/usr/libexec/aetheri/aetheri-wlan-control
SELinuxContext=system_u:system_r:aetheri_wlan_control_t:s0
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
DevicePolicy=closed
RestrictAddressFamilies=AF_UNIX
TimeoutStartSec=12s

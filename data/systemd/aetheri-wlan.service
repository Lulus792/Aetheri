[Unit]
Description=Aetheri Wireless Service
AssertSecurity=selinux
Requires=dbus.service
After=dbus.service aetheri-udev.service

[Service]
Type=dbus
BusName=net.connman.iwd
ExecStart=/usr/libexec/iwd
SELinuxContext=system_u:system_r:aetheri_wlan_t:s0
Environment=DBUS_SYSTEM_BUS_ADDRESS=unix:path=/run/dbus/system_bus_socket
Environment=CONFIGURATION_DIRECTORY=/usr/share/aetheri/wlan
Environment=STATE_DIRECTORY=/run/aetheri-wlan
RuntimeDirectory=aetheri-wlan
RuntimeDirectoryMode=0700
UMask=0077
Restart=no
TimeoutStartSec=25s
TimeoutStopSec=10s
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
DevicePolicy=closed
DeviceAllow=/dev/rfkill rw
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectControlGroups=yes
ProtectKernelModules=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_PACKET AF_ALG AF_INET AF_INET6

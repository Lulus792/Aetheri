+static int Wayland_WaitReadiness(SDL_VideoData *d, int flags, Sint64 timeoutNS, bool *woke)
+{
+    *woke = false;
+#ifdef SDL_PLATFORM_LINUX
+    if (d->wakeup_fd < 0) {
+        errno = EBADF;
+        return -1;
+    }
+    struct pollfd fds[2] = {
+        { WAYLAND_wl_display_get_fd(d->display), 0, 0 },
+        { d->wakeup_fd, POLLIN, 0 }
+    };
+    if (flags & SDL_IOR_READ) {
+        fds[0].events |= POLLIN | POLLPRI;
+    }
+    if (flags & SDL_IOR_WRITE) {
+        fds[0].events |= POLLOUT;
+    }
+    int result;
+#ifdef HAVE_PPOLL
+    struct timespec ts, *timeout = NULL;
+    if (timeoutNS >= 0) {
+        ts.tv_sec = SDL_NS_TO_SECONDS(timeoutNS);
+        ts.tv_nsec = timeoutNS - SDL_SECONDS_TO_NS(ts.tv_sec);
+        timeout = &ts;
+    }
+    result = ppoll(fds, 2, timeout, NULL);
+#else
+    int timeoutMS = -1;
+    if (timeoutNS >= 0) {
+        timeoutMS = timeoutNS >= SDL_MS_TO_NS(SDL_MAX_SINT32) ? SDL_MAX_SINT32 :
+                    (int)SDL_NS_TO_MS(timeoutNS + (SDL_NS_PER_MS - 1));
+    }
+    result = poll(fds, 2, timeoutMS);
+#endif
+    // Preserve the caller's existing no-retry/EINTR and monotonic-budget path.
+    if (result <= 0) {
+        return result;
+    }
+    if (fds[1].revents & (POLLERR | POLLHUP | POLLNVAL)) {
+        errno = EBADF;
+        return -1;
+    }
+    if (fds[1].revents & POLLIN) {
+        eventfd_t count;
+        do {
+            result = eventfd_read(d->wakeup_fd, &count);
+        } while (result < 0 && errno == EINTR);
+        if (result < 0 && errno != EAGAIN) {
+            return -1;
+        }
+        *woke = true;
+        return 1;
+    }
+    return fds[0].revents ? 1 : 0;
+#else
+    return SDL_IOReady(WAYLAND_wl_display_get_fd(d->display), flags, timeoutNS);
+#endif
 }
 

; MIT. Candidate login roles, combined with login-startup.cil.
; Not an installed policy or complete daemon/account/device admission.
(type aetheri_login_backend_t)
(type aetheri_login_worker_t)
(type aetheri_greeter_t)
(type aetheri_login_backend_exec_t)
(type aetheri_greeter_exec_t)
(type aetheri_login_config_t)
(type aetheri_login_socket_t)
(type aetheri_login_state_t)
(type aetheri_login_log_t)
(typeattribute aetheri_login_roles)
(expandtypeattribute (aetheri_login_roles) false)
(typeattributeset aetheri_login_roles (aetheri_login_backend_t aetheri_login_worker_t aetheri_greeter_t))
(typeattributeset domain (aetheri_login_roles))
; Fedora's authlogin neverallow independently requires an explicit declaration
; for every shadow reader. Only the PAM worker belongs to that set.
(typeattributeset can_read_shadow_passwords (aetheri_login_worker_t))
(typeattributeset file_type (aetheri_login_backend_exec_t aetheri_greeter_exec_t aetheri_login_config_t aetheri_login_socket_t aetheri_login_state_t aetheri_login_log_t))
(typeattributeset exec_type (aetheri_login_backend_exec_t aetheri_greeter_exec_t))
(typeattributeset entry_type (aetheri_login_backend_exec_t aetheri_greeter_exec_t))
(roletype system_r aetheri_login_backend_t)
(roletype system_r aetheri_login_worker_t)
(roletype system_r aetheri_greeter_t)
(typeattributeset aetheri_login_observed_backend (aetheri_login_backend_t))

; The finite publisher verifies the selected backend sources and connects to
; the typed listener to pin its original service. Only the backend owns them.
(allow aetheri_login_startup_t aetheri_login_backend_exec_t (file (read open getattr)))
(allow aetheri_login_startup_t aetheri_login_config_t (file (read open getattr)))
(allow aetheri_login_startup_t aetheri_greeter_exec_t (file (read open getattr)))
(allow aetheri_login_startup_t aetheri_login_socket_t (sock_file (write getattr)))
; The compiled admission gate can bind the current effective policy digest.
(allow aetheri_login_startup_t security_t (security (read_policy)))
(neverallow aetheri_login_startup_t aetheri_login_backend_exec_t (file (write execute execute_no_trans)))
(neverallow aetheri_login_startup_t aetheri_login_config_t (file (write create unlink)))
(neverallow aetheri_login_startup_t aetheri_login_socket_t (sock_file (create setattr unlink)))
(neverallow aetheri_login_startup_t var_run_t (sock_file (write)))

; PID1 starts only the backend. Its self-exec creates the external PAM worker;
; the unprivileged worker child transitions on the selected greeter executable.
(allow init_t aetheri_login_backend_t (process (transition)))
(allow init_t aetheri_login_backend_t (process2 (nnp_transition)))
(allow init_t aetheri_login_backend_exec_t (file (read open getattr execute map)))
(allow aetheri_login_backend_t aetheri_login_backend_exec_t (file (entrypoint read open getattr execute map)))
(allow aetheri_login_backend_t aetheri_login_worker_t (process (transition getattr sigchld siginh rlimitinh signal signull)))
(allow aetheri_login_backend_t aetheri_login_worker_t (process2 (nnp_transition)))
(typetransition aetheri_login_backend_t aetheri_login_backend_exec_t process aetheri_login_worker_t)
(allow aetheri_login_worker_t aetheri_login_backend_exec_t (file (entrypoint read open getattr execute map)))
(allow aetheri_login_worker_t aetheri_greeter_t (process (transition getattr siginh rlimitinh sigkill signal signull)))
(allow aetheri_login_worker_t aetheri_greeter_t (process2 (nnp_transition)))
(typetransition aetheri_login_worker_t aetheri_greeter_exec_t process aetheri_greeter_t)
(allow aetheri_login_worker_t aetheri_greeter_exec_t (file (read open getattr execute map)))
(allow aetheri_greeter_t aetheri_greeter_exec_t (file (entrypoint read open getattr execute map)))
(allow aetheri_greeter_t aetheri_login_worker_t (process (sigchld getattr)))
(allow aetheri_login_worker_t aetheri_login_backend_t (process (sigchld getattr)))
(allow aetheri_login_roles self (process (fork getattr getcap sigchld signull signal getsession setpgid)))
(allow aetheri_login_roles init_t (process (sigchld getattr)))
(allow aetheri_login_roles init_t (fd (use)))
(allow aetheri_login_roles init_t (unix_stream_socket (write getattr ioctl)))
(allow aetheri_login_roles self (dir (search read open getattr)))
(allow aetheri_login_roles self (file (read open getattr)))
(allow aetheri_login_roles self (lnk_file (read getattr)))

; Protected runtime/linker inputs and public account metadata.
(allow aetheri_login_roles root_t (dir (search getattr)))
(allow aetheri_login_roles usr_t (dir (search read open getattr)))
(allow aetheri_login_roles var_t (dir (search getattr)))
(allow aetheri_login_roles var_run_t (dir (search getattr)))
(allow aetheri_login_roles init_var_run_t (dir (search getattr)))
(allow aetheri_login_roles etc_t (dir (search getattr)))
(allow aetheri_login_roles etc_t (file (read open getattr)))
(allow aetheri_login_roles etc_t (lnk_file (read getattr)))
(allow aetheri_login_roles passwd_file_t (file (read open getattr)))
(allow aetheri_login_roles lib_t (dir (search getattr)))
(allow aetheri_login_roles lib_t (file (read open getattr execute map)))
(allow aetheri_login_roles lib_t (lnk_file (read getattr)))
(allow aetheri_login_roles ld_so_t (file (read open getattr execute map)))
(allow aetheri_login_roles ld_so_cache_t (file (read open getattr map)))
(allow aetheri_login_roles aetheri_login_config_t (file (read open getattr)))
(allow aetheri_login_roles security_t (dir (search getattr)))
(allow aetheri_login_roles security_t (file (read open getattr)))
(allow aetheri_login_roles proc_t (dir (search read open getattr)))
(allow aetheri_login_roles proc_t (file (read open getattr)))
(allow aetheri_login_roles proc_t (lnk_file (read getattr)))
(allow aetheri_login_roles sysctl_t (dir (search getattr)))
(allow aetheri_login_roles sysctl_kernel_t (dir (search getattr)))
(allow aetheri_login_roles sysctl_kernel_t (file (read open getattr)))
(allow aetheri_login_roles pidfs_t (filesystem (getattr)))
(allow aetheri_login_roles nsfs_t (filesystem (getattr)))
(allow aetheri_login_roles null_device_t (chr_file (read write open getattr ioctl)))
; The disposable probe's inherited OpenFile is RDWR|APPEND. No credentials are
; logged. Retaining that exact OFD across transitions also needs read permission.
(allow aetheri_login_roles aetheri_login_log_t (file (read append getattr ioctl)))
; PID1 opens that selected diagnostic OFD before changing domain.
(allow init_t aetheri_login_log_t (file (read open append getattr)))

; Backend state and credential-free local protocol only.
(allow aetheri_login_backend_t self (capability (chown sys_tty_config)))
; The reviewed server waits for its selected VT and resets it on startup error.
; Keep this upstream recovery path; the greeter gets no direct TTY permission.
(allow aetheri_login_backend_t device_t (dir (search getattr)))
(allow aetheri_login_backend_t tty_device_t (chr_file (read write open getattr ioctl)))
(allow aetheri_login_backend_t self (unix_stream_socket (create bind listen accept read write getattr getopt setopt shutdown)))
(allow aetheri_login_backend_t self (unix_dgram_socket (create connect read write getattr getopt setopt sendto shutdown)))
(allow aetheri_login_backend_t var_run_t (dir (write add_name remove_name)))
(typetransition aetheri_login_backend_t var_run_t sock_file aetheri_login_socket_t)
(allow aetheri_login_backend_t aetheri_login_socket_t (sock_file (create setattr getattr unlink)))
(allow aetheri_login_backend_t aetheri_login_runtime_t (dir (search getattr write add_name)))
(typetransition aetheri_login_backend_t aetheri_login_runtime_t file aetheri_login_state_t)
(allow aetheri_login_backend_t aetheri_login_state_t (file (create read write open getattr)))
(allow aetheri_login_backend_t init_var_run_t (sock_file (write)))
(allow aetheri_login_backend_t init_t (unix_dgram_socket (sendto)))

; Privileged PAM worker: explicit account/TTY/session operations, no Internet.
(allow aetheri_login_worker_t self (capability (chown dac_read_search setuid setgid kill sys_tty_config audit_write)))
; libpam's built-in audit is local kernel reporting, not Internet networking or
; permission to control/read privileged audit configuration and records.
(allow aetheri_login_worker_t self (netlink_audit_socket (create read write getattr nlmsg_relay)))
(allow aetheri_login_worker_t shadow_t (file (read open getattr)))
; The distribution PAM can delegate shadow authentication and expiry checks to
; unix_chkpwd. Keep its existing confined domain and the worker-owned pipes.
(allow aetheri_login_worker_t chkpwd_exec_t (file (read open getattr execute map)))
(typetransition aetheri_login_worker_t chkpwd_exec_t process chkpwd_t)
(allow aetheri_login_worker_t chkpwd_t (process (transition)))
(allow aetheri_login_worker_t chkpwd_t (process2 (nnp_transition)))
(allow chkpwd_t aetheri_login_worker_t (process (sigchld)))
(allow chkpwd_t aetheri_login_worker_t (fd (use)))
(allow chkpwd_t aetheri_login_worker_t (fifo_file (read write append getattr ioctl)))
(neverallow aetheri_login_worker_t chkpwd_exec_t (file (execute_no_trans write)))
(neverallow aetheri_login_backend_t chkpwd_exec_t (file (execute)))
(neverallow aetheri_greeter_t chkpwd_exec_t (file (execute)))
(allow aetheri_login_worker_t self (file (write)))
(allow aetheri_login_worker_t self (unix_stream_socket (create connect read write getattr getopt setopt shutdown)))
(allow aetheri_login_worker_t self (unix_dgram_socket (create connect read write getattr getopt setopt sendto shutdown)))
(allow aetheri_login_worker_t aetheri_login_backend_t (fd (use)))
(allow aetheri_login_worker_t aetheri_login_backend_t (unix_dgram_socket (read write getattr getopt setopt sendto shutdown)))
(allow aetheri_login_worker_t shell_exec_t (file (read open getattr execute execute_no_trans map)))
(allow aetheri_login_worker_t device_t (dir (search getattr)))
(allow aetheri_login_worker_t tty_device_t (chr_file (read write open getattr ioctl)))
(allow aetheri_login_worker_t systemd_logind_var_run_t (sock_file (write getattr)))
(allow aetheri_login_worker_t systemd_logind_t (unix_stream_socket (connectto)))
(allow aetheri_login_worker_t systemd_logind_t (fd (use)))
(allow aetheri_login_worker_t systemd_userdbd_runtime_t (dir (search getattr)))
(allow aetheri_login_worker_t systemd_userdbd_runtime_t (sock_file (write getattr)))
(allow aetheri_login_worker_t systemd_userdbd_t (unix_stream_socket (connectto)))
; pam_systemd inspects the runtime parent even for a class=greeter session.
(allow aetheri_login_worker_t user_tmp_t (dir (search getattr)))
(allow aetheri_login_worker_t devlog_t (sock_file (write getattr)))
(allow aetheri_login_worker_t devlog_t (lnk_file (read getattr)))
(allow aetheri_login_worker_t syslogd_var_run_t (dir (search getattr)))
(allow aetheri_login_worker_t syslogd_t (unix_dgram_socket (sendto)))
(allow systemd_logind_t aetheri_login_worker_t (process (getattr)))
(allow systemd_logind_t aetheri_login_worker_t (dir (search getattr)))
(allow systemd_logind_t aetheri_login_worker_t (file (read open getattr)))
(allow systemd_logind_t aetheri_login_worker_t (lnk_file (read getattr)))
(allow systemd_logind_t aetheri_login_worker_t (fd (use)))

; The greeter has no account-changing capability or direct device access.
(allow aetheri_greeter_t aetheri_login_backend_t (fd (use)))
(allow aetheri_greeter_t aetheri_login_worker_t (fd (use)))
(allow aetheri_greeter_t aetheri_login_backend_exec_t (file (read open getattr)))
(allow aetheri_greeter_t self (unix_stream_socket (create connect read write getattr getopt setopt shutdown)))
(allow aetheri_greeter_t aetheri_login_backend_t (unix_stream_socket (connectto)))
(allow aetheri_greeter_t aetheri_login_socket_t (sock_file (write getattr)))
(allow aetheri_greeter_t aetheri_login_runtime_t (dir (search read open getattr)))
(allow aetheri_greeter_t aetheri_login_handoff_t (file (read open getattr)))

; Match the live backend's invocation and source files through the existing
; system manager. Do not grant execution, signalling or control of the backend.
(allow aetheri_greeter_t system_dbusd_var_run_t (dir (search getattr)))
(allow aetheri_greeter_t system_dbusd_var_run_t (sock_file (write getattr)))
(allow aetheri_greeter_t system_dbusd_t (unix_stream_socket (connectto)))
(allow aetheri_greeter_t system_dbusd_t (dbus (send_msg)))
(allow system_dbusd_t aetheri_greeter_t (dbus (send_msg)))
(allow aetheri_greeter_t system_dbusd_t (fd (use)))
(allow aetheri_greeter_t init_t (dbus (send_msg)))
(allow init_t aetheri_greeter_t (dbus (send_msg)))
(allow aetheri_greeter_t init_t (system (status)))
(allow aetheri_greeter_t init_t (unix_stream_socket (read)))
(allow aetheri_greeter_t init_var_run_t (dir (read open)))
(allow aetheri_greeter_t systemd_unit_file_t (dir (search read open getattr)))
(allow aetheri_greeter_t systemd_unit_file_t (file (read open getattr)))
(allow aetheri_greeter_t systemd_unit_file_t (service (status)))
(allow aetheri_greeter_t sysfs_t (dir (search getattr)))
(allow aetheri_greeter_t cgroup_t (dir (search read open getattr)))
(allow aetheri_greeter_t cgroup_t (filesystem (getattr)))
(allow aetheri_greeter_t fs_t (filesystem (getattr)))
(allow aetheri_greeter_t tmpfs_t (filesystem (getattr)))
(allow aetheri_greeter_t aetheri_login_backend_t (process (getattr)))
(allow aetheri_greeter_t aetheri_login_backend_t (dir (search getattr)))
(allow aetheri_greeter_t aetheri_login_backend_t (file (read open getattr)))
(allow aetheri_greeter_t aetheri_login_worker_t (dir (search getattr)))
(allow aetheri_greeter_t aetheri_login_worker_t (file (read open getattr)))
(neverallow aetheri_greeter_t aetheri_login_backend_t (process (ptrace signal sigkill)))
(neverallow aetheri_greeter_t aetheri_login_worker_t (process (ptrace signal sigkill)))
(neverallow aetheri_greeter_t aetheri_login_handoff_t (file (write create unlink)))

; Post-authentication entry for the selected desktop. The worker can enter
; this domain only by executing the separately labeled session entry.
(type aetheri_session_t)
(type aetheri_session_exec_t)
(type aetheri_session_core_exec_t)
(type aetheri_session_runtime_t)
(type aetheri_session_shm_t)
(type aetheri_session_memfd_t)
(typeattributeset domain (aetheri_session_t))
(typeattributeset file_type (aetheri_session_exec_t aetheri_session_core_exec_t aetheri_session_runtime_t aetheri_session_shm_t aetheri_session_memfd_t))

(allow aetheri_session_t aetheri_session_runtime_t (sock_file (create write getattr unlink)))
(allow aetheri_session_runtime_t tmpfs_t (filesystem (associate)))
; The unit selects a private /dev/shm with this directory type so POSIX shared
; buffers need no write access to the carrier's generic tmpfs files.
(allow aetheri_session_shm_t tmpfs_t (filesystem (associate)))
(allow aetheri_session_t aetheri_session_shm_t (dir (search read open getattr write add_name remove_name)))
(allow aetheri_session_t aetheri_session_shm_t (file (create read write open getattr setattr unlink map)))
; The current carrier labels internal shmem from the allocating domain and

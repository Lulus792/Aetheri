(allow aetheri_session_t proc_t (file (read open getattr)))
(allow aetheri_session_t proc_t (lnk_file (read getattr)))
; sd-login resolves the current session relative to PID1's cgroup root.
(allow aetheri_session_t init_t (dir (search)))
(allow aetheri_session_t init_t (file (read open getattr)))
(allow aetheri_session_t var_run_t (dir (search getattr)))
(allow aetheri_session_t init_var_run_t (dir (search getattr)))
(allow aetheri_session_t systemd_logind_sessions_t (dir (search read open getattr watch)))
(allow aetheri_session_t systemd_logind_sessions_t (file (read open getattr)))
(allow aetheri_session_t user_tmp_t (dir (search getattr write add_name remove_name)))
(typetransition aetheri_session_t user_tmp_t dir aetheri_session_runtime_t)

(allow aetheri_session_t udev_var_run_t (sock_file (getattr)))
(allow aetheri_session_t sysfs_t (dir (search read open getattr)))
(allow aetheri_session_t sysfs_t (file (read open getattr)))
(allow aetheri_session_t sysfs_t (lnk_file (read getattr)))
(allow aetheri_session_t self (netlink_kobject_uevent_socket (create bind read getattr getopt setopt)))

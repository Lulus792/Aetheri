(typetransition aetheri_session_t tmpfs_t file aetheri_session_memfd_t)
(allow aetheri_session_memfd_t tmpfs_t (filesystem (associate)))
(allow aetheri_session_t aetheri_session_memfd_t (file (read write getattr map)))

; MIT. Disposable carrier probe only; not a production app policy.
(type aetheri_p0_app_t)
(typeattributeset domain (aetheri_p0_app_t))
(typeattributeset mcs_constrained_type (aetheri_p0_app_t))
(roletype system_r aetheri_p0_app_t)
(type aetheri_p0_exec_t)
(type aetheri_p0_fixture_t)
(type aetheri_p0_data_t)
(type aetheri_p0_private_t)
(type aetheri_p0_document_t)
(typeattributeset file_type (aetheri_p0_exec_t aetheri_p0_fixture_t aetheri_p0_data_t aetheri_p0_private_t aetheri_p0_document_t))
(typeattributeset exec_type (aetheri_p0_exec_t))
(typeattributeset entry_type (aetheri_p0_exec_t))

; Narrow permissions for the existing trusted supervisor's test-domain setup.
(allow init_t aetheri_p0_app_t (process (transition)))
(allow init_t aetheri_p0_app_t (process2 (nnp_transition)))
(allow init_t aetheri_p0_data_t (dir (mounton)))
(allow init_t aetheri_p0_exec_t (file (read open getattr execute map)))
(allow aetheri_p0_app_t init_t (fd (use)))
(allow aetheri_p0_app_t init_t (process (sigchld)))
(allow aetheri_p0_app_t aetheri_p0_exec_t (file (entrypoint execute read open getattr map)))
(allow aetheri_p0_app_t self (process (fork sigchld signull signal sigkill getcap)))

; Dynamic loader and C runtime, read-only. No general bin_t execution.
(allow aetheri_p0_app_t root_t (dir (search getattr)))
(allow aetheri_p0_app_t usr_t (dir (search getattr)))
(allow aetheri_p0_app_t lib_t (dir (search getattr)))
(allow aetheri_p0_app_t lib_t (file (read open getattr execute map)))
(allow aetheri_p0_app_t ld_so_t (file (read open getattr execute map)))
(allow aetheri_p0_app_t ld_so_cache_t (file (read open getattr map)))
(allow aetheri_p0_app_t lib_t (lnk_file (read getattr)))
(allow aetheri_p0_app_t null_device_t (chr_file (read write open getattr ioctl)))

; Read its own kernel-provided process label; no ptrace of controller/supervisor.
(allow aetheri_p0_app_t proc_t (dir (search)))
(allow aetheri_p0_app_t proc_t (lnk_file (read)))
(allow aetheri_p0_app_t self (dir (search getattr)))
(allow aetheri_p0_app_t self (file (read open getattr)))
(allow aetheri_p0_app_t self (lnk_file (read getattr)))
(allow aetheri_p0_app_t var_t (dir (search getattr)))
(allow aetheri_p0_app_t var_lib_t (dir (search getattr)))
(allow aetheri_p0_app_t aetheri_p0_fixture_t (dir (search getattr)))

; Both fixtures use one data type. MCS categories must enforce separation.
(allow aetheri_p0_app_t aetheri_p0_data_t (dir (search read getattr write add_name remove_name create rmdir)))
(allow aetheri_p0_app_t aetheri_p0_data_t (file (read write append open getattr create unlink rename)))

(neverallow aetheri_p0_app_t aetheri_p0_private_t (file (read write append open map execute)))
(neverallow aetheri_p0_app_t aetheri_p0_document_t (file (read write append open map execute)))
(neverallow aetheri_p0_app_t self (process (setexec setcurrent dyntransition)))
(neverallow aetheri_p0_app_t self (capability (sys_admin sys_ptrace setuid setgid dac_override dac_read_search)))
(neverallow aetheri_p0_app_t init_t (process (ptrace)))
(neverallow aetheri_p0_app_t unconfined_t (process (ptrace)))

; Fixed desktop application entrypoints. This policy does not select packages.
(type aetheri_settings_t)
(type aetheri_settings_exec_t)
(type aetheri_files_t)
(type aetheri_files_exec_t)
(type aetheri_terminal_t)
(type aetheri_terminal_exec_t)
(type aetheri_terminal_helper_exec_t)
(type aetheri_terminal_pty_t)
(type aetheri_documents_t)
(typeattribute aetheri_desktop_apps)
(typeattribute aetheri_document_apps)
(typeattributeset aetheri_desktop_apps (aetheri_settings_t aetheri_files_t aetheri_terminal_t))
(typeattributeset aetheri_document_apps (aetheri_files_t aetheri_terminal_t))
(typeattributeset domain (aetheri_settings_t aetheri_files_t aetheri_terminal_t))
(typeattributeset file_type (aetheri_settings_exec_t aetheri_files_exec_t aetheri_terminal_exec_t
    aetheri_terminal_helper_exec_t aetheri_terminal_pty_t aetheri_documents_t))
(typeattributeset exec_type (aetheri_settings_exec_t aetheri_files_exec_t aetheri_terminal_exec_t
    aetheri_terminal_helper_exec_t))
(typeattributeset entry_type (aetheri_settings_exec_t aetheri_files_exec_t aetheri_terminal_exec_t))

(macro aetheri_app_entry ((type parent) (type app) (type program))
    (roletype system_r app)
    (typetransition parent program process app)
    (allow parent program (file (read open getattr execute map)))
    (allow parent app (process (transition getattr siginh rlimitinh signal signull sigkill)))
    (allow parent app (process2 (nnp_transition)))
    (allow app program (file (entrypoint read open getattr execute map)))
    (allow app parent (process (sigchld)))
    (allow app parent (fd (use)))
    (neverallow parent program (file (execute_no_trans write create unlink))))
(call aetheri_app_entry (aetheri_session_t aetheri_settings_t aetheri_settings_exec_t))
(call aetheri_app_entry (aetheri_session_t aetheri_files_t aetheri_files_exec_t))
(call aetheri_app_entry (aetheri_session_t aetheri_terminal_t aetheri_terminal_exec_t))
(call aetheri_app_entry (aetheri_files_t aetheri_terminal_t aetheri_terminal_exec_t))

(allow aetheri_desktop_apps aetheri_session_t (fifo_file (write append getattr ioctl)))
(allow aetheri_desktop_apps self (process (fork getattr getcap sigchld signal signull setsched)))
(allow aetheri_desktop_apps self (fd (use)))
(allow aetheri_desktop_apps self (dir (search read open getattr)))
(allow aetheri_desktop_apps self (file (read open getattr)))
(allow aetheri_desktop_apps self (lnk_file (read getattr)))
(allow aetheri_desktop_apps root_t (dir (search getattr)))
(allow aetheri_desktop_apps usr_t (dir (search read open getattr)))
(allow aetheri_desktop_apps usr_t (file (read open getattr map)))
(allow aetheri_desktop_apps usr_t (lnk_file (read getattr)))
(allow aetheri_desktop_apps lib_t (dir (search getattr)))
(allow aetheri_desktop_apps lib_t (file (read open getattr execute map)))
(allow aetheri_desktop_apps lib_t (lnk_file (read getattr)))
(allow aetheri_desktop_apps ld_so_t (file (read open getattr execute map)))
(allow aetheri_desktop_apps ld_so_cache_t (file (read open getattr map)))
(allow aetheri_desktop_apps etc_t (dir (search getattr)))
(allow aetheri_desktop_apps etc_t (file (read open getattr)))
(allow aetheri_desktop_apps proc_t (dir (search getattr)))
(allow aetheri_desktop_apps proc_t (file (read open getattr)))
(allow aetheri_desktop_apps proc_t (lnk_file (read getattr)))
(allow aetheri_desktop_apps device_t (dir (search getattr)))
(allow aetheri_desktop_apps null_device_t (chr_file (read write open getattr ioctl)))

; Wayland is the existing private compositor socket and inherited session path.
(allow aetheri_desktop_apps var_run_t (dir (search getattr)))
(allow aetheri_desktop_apps user_tmp_t (dir (search getattr)))
(allow aetheri_desktop_apps aetheri_session_runtime_t (dir (search getattr)))
(allow aetheri_desktop_apps aetheri_session_runtime_t (sock_file (write getattr)))
(allow aetheri_desktop_apps self (unix_stream_socket (create connect read write getattr getopt setopt shutdown)))
(allow aetheri_desktop_apps aetheri_session_t (unix_stream_socket (connectto read write getattr getopt setopt shutdown)))
(allow aetheri_session_t aetheri_desktop_apps (fd (use)))
(allow aetheri_desktop_apps self (fifo_file (create read write open getattr ioctl)))
(allow aetheri_desktop_apps aetheri_login_shm_dir_t (dir (search getattr add_name remove_name write)))
(typetransition aetheri_settings_t aetheri_login_shm_dir_t file aetheri_session_shm_t)
(typetransition aetheri_files_t aetheri_login_shm_dir_t file aetheri_session_shm_t)
(typetransition aetheri_terminal_t aetheri_login_shm_dir_t file aetheri_session_shm_t)
(allow aetheri_desktop_apps aetheri_session_shm_t (file (create read write open getattr setattr unlink map)))
(typetransition aetheri_settings_t tmpfs_t file aetheri_session_memfd_t)
(typetransition aetheri_files_t tmpfs_t file aetheri_session_memfd_t)
(typetransition aetheri_terminal_t tmpfs_t file aetheri_session_memfd_t)
(allow aetheri_desktop_apps aetheri_session_memfd_t (file (read write getattr map)))

; Local file applications use a deliberately labelled user document tree.
; DAC ownership remains effective. Settings has no document permission.
(allow aetheri_document_apps home_root_t (dir (search getattr)))
(allow aetheri_document_apps user_home_dir_t (dir (search getattr)))
(allow aetheri_files_t self (process (setpgid)))
; The shell checks an original job member before handing it the foreground PTY.
(allow aetheri_terminal_t self (process (getpgid setpgid getsession)))
(allow aetheri_files_t aetheri_terminal_t (fd (use)))
(allow aetheri_terminal_t aetheri_files_t (fd (use)))
(allow aetheri_terminal_t aetheri_files_t (fifo_file (write append getattr ioctl)))
(allow aetheri_document_apps aetheri_documents_t (dir (create search read open getattr setattr add_name remove_name write rmdir rename watch)))
(allow aetheri_document_apps aetheri_documents_t (file (create read write append open getattr setattr rename unlink map lock)))

; Only Terminal can launch the fixed PTY starter, shell and editor.
(allow aetheri_terminal_t aetheri_terminal_helper_exec_t (file (read open getattr execute execute_no_trans map)))
(allow aetheri_terminal_t ptmx_t (chr_file (read write open getattr ioctl)))
(allow aetheri_terminal_t devpts_t (dir (search getattr)))
(typetransition aetheri_terminal_t devpts_t chr_file aetheri_terminal_pty_t)
(allow aetheri_terminal_pty_t devpts_t (filesystem (associate)))
(allow aetheri_terminal_t aetheri_terminal_pty_t (chr_file (create read write open getattr setattr ioctl lock)))

(neverallow aetheri_desktop_apps bin_t (file (execute execute_no_trans)))
(neverallow aetheri_desktop_apps shadow_t (file (read open write)))
(neverallow aetheri_desktop_apps self (process (execmem)))
(neverallow aetheri_desktop_apps aetheri_session_t (process (ptrace signal sigkill)))
(neverallow aetheri_desktop_apps aetheri_login_handoff_t (file (write create unlink)))
(neverallow aetheri_desktop_apps dri_device_t (chr_file (open read write ioctl)))
(neverallow aetheri_desktop_apps event_device_t (chr_file (open read write ioctl)))
(neverallow aetheri_settings_t aetheri_documents_t (file (read write open)))
(neverallow aetheri_settings_t aetheri_terminal_helper_exec_t (file (execute execute_no_trans)))
(neverallow aetheri_files_t aetheri_terminal_helper_exec_t (file (execute execute_no_trans)))

; MIT. The installed iwd service has one fixed executable and private state.
(type aetheri_wlan_t)
(type aetheri_wlan_exec_t)
(type aetheri_wlan_config_t)
(type aetheri_wlan_runtime_t)
(typeattributeset domain (aetheri_wlan_t))
(typeattributeset file_type (aetheri_wlan_exec_t aetheri_wlan_config_t aetheri_wlan_runtime_t))
(typeattributeset exec_type (aetheri_wlan_exec_t))
(typeattributeset entry_type (aetheri_wlan_exec_t))
(roletype system_r aetheri_wlan_t)

(typetransition init_t aetheri_wlan_exec_t process aetheri_wlan_t)
(allow init_t aetheri_wlan_t (process (transition getattr signal sigkill signull)))
(allow init_t aetheri_wlan_t (process2 (nnp_transition)))
(allow init_t aetheri_wlan_exec_t (file (read open getattr execute map)))
(allow aetheri_wlan_t aetheri_wlan_exec_t (file (entrypoint execute read open getattr map)))
(allow aetheri_wlan_t init_t (fd (use)))
(allow aetheri_wlan_t init_t (process (sigchld)))
; systemd supplies the journal stream before the process transition.
(allow aetheri_wlan_t init_t (unix_stream_socket (write getattr ioctl)))
(allow aetheri_wlan_t self (process (getattr getcap signal signull)))
(allow aetheri_wlan_t self (capability (net_admin net_raw net_bind_service)))
(allow aetheri_wlan_t self (key (write)))

(allow aetheri_wlan_t root_t (dir (search getattr)))
(allow aetheri_wlan_t usr_t (dir (search getattr)))
(allow aetheri_wlan_t var_run_t (dir (search getattr)))
(allow aetheri_wlan_t lib_t (dir (search getattr)))
(allow aetheri_wlan_t lib_t (lnk_file (read getattr)))
(allow aetheri_wlan_t lib_t (file (read open getattr execute map)))
(allow aetheri_wlan_t ld_so_t (file (read open getattr execute map)))
(allow aetheri_wlan_t ld_so_cache_t (file (read open getattr map)))
(allow aetheri_wlan_t aetheri_wlan_config_t (dir (search read open getattr)))
(allow aetheri_wlan_t aetheri_wlan_config_t (file (read open getattr map)))

; PID 1 prepares the private 0700 directory before executing the service,
; and removes its contents after the final daemon process exits.
(typetransition init_t var_run_t dir "aetheri-wlan" aetheri_wlan_runtime_t)
(allow init_t aetheri_wlan_runtime_t (dir (create search getattr setattr read open write add_name remove_name rmdir mounton)))
(allow init_t aetheri_wlan_runtime_t (file (getattr unlink)))
(allow aetheri_wlan_t aetheri_wlan_runtime_t (dir (create search read open getattr setattr watch watch_reads write add_name remove_name rmdir)))
(allow aetheri_wlan_t aetheri_wlan_runtime_t (file (create read write open getattr setattr map rename unlink)))

(allow aetheri_wlan_t device_t (dir (search getattr)))
(allow aetheri_wlan_t wireless_device_t (chr_file (open read write getattr)))
(allow aetheri_wlan_t null_device_t (chr_file (open read write getattr)))
(allow aetheri_wlan_t urandom_device_t (chr_file (open read getattr)))
(allow aetheri_wlan_t sysfs_t (dir (search read open getattr)))
(allow aetheri_wlan_t sysfs_t (file (read open getattr)))
(allow aetheri_wlan_t sysfs_t (lnk_file (read getattr)))
(allow aetheri_wlan_t sysctl_net_t (dir (search getattr)))
(allow aetheri_wlan_t sysctl_net_t (file (read open getattr)))
(allow aetheri_wlan_t udev_var_run_t (dir (search read open getattr)))
(allow aetheri_wlan_t udev_var_run_t (file (read open getattr)))

(allow aetheri_wlan_t self (alg_socket (create bind accept read write getattr getopt setopt)))
(allow aetheri_wlan_t self (netlink_generic_socket (create bind read write getattr getopt setopt)))
(allow aetheri_wlan_t self (netlink_route_socket (create bind read write getattr getopt setopt nlmsg_read nlmsg_write)))
(allow aetheri_wlan_t self (netlink_kobject_uevent_socket (create bind read getattr getopt setopt)))
(allow aetheri_wlan_t self (packet_socket (create bind read write getattr getopt setopt ioctl)))
(allow aetheri_wlan_t self (udp_socket (create bind connect read write getattr getopt setopt ioctl)))
(allow aetheri_wlan_t self (rawip_socket (create bind read write getattr getopt setopt ioctl)))

(allow aetheri_wlan_t self (unix_stream_socket (create connect read write getattr getopt setopt shutdown)))
; ELL looks up the interface name with SIOCGIFNAME on this socket.
(allow aetheri_wlan_t self (unix_dgram_socket (create ioctl)))
(allowx aetheri_wlan_t self (ioctl unix_dgram_socket (0x8910)))
(allow aetheri_wlan_t system_dbusd_var_run_t (dir (search getattr)))
(allow aetheri_wlan_t system_dbusd_var_run_t (sock_file (write getattr)))
(allow aetheri_wlan_t system_dbusd_t (unix_stream_socket (connectto)))
(allow aetheri_wlan_t system_dbusd_t (dbus (send_msg acquire_svc)))
(allow system_dbusd_t aetheri_wlan_t (dbus (send_msg)))
(allow aetheri_wlan_t syslogd_t (fd (use)))
(allow aetheri_wlan_t syslogd_t (unix_stream_socket (write getattr)))

(neverallow aetheri_desktop_apps aetheri_wlan_exec_t (file (execute execute_no_trans entrypoint write)))
(neverallow aetheri_desktop_apps aetheri_wlan_runtime_t (dir (search open read write add_name remove_name)))
(neverallow aetheri_desktop_apps aetheri_wlan_t (dbus (send_msg)))
(neverallow aetheri_wlan_t aetheri_wlan_config_t (file (write create unlink rename)))
(neverallow aetheri_wlan_t sysctl_net_t (file (write create unlink)))
(neverallow aetheri_wlan_t user_home_t (file (read open write execute)))
(neverallow aetheri_wlan_t shadow_t (file (read open write)))
(neverallow aetheri_wlan_t bin_t (file (execute execute_no_trans entrypoint)))
(neverallow aetheri_wlan_t sound_device_t (chr_file (open read write)))
(neverallow aetheri_wlan_t self (tcp_socket (create connect)))
(neverallow aetheri_wlan_t self (process (execmem ptrace)))
(neverallow aetheri_wlan_t self (capability (sys_admin sys_module sys_ptrace setuid setgid dac_override dac_read_search)))

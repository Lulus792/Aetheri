; Installed lock dialog and inherited authority connection.
(type aetheri_lock_view_t)
(type aetheri_lock_view_exec_t)
(type aetheri_unlock_pam_t)
(type aetheri_lock_pixels_t)
(typeattributeset domain (aetheri_lock_view_t))
(typeattributeset file_type (aetheri_lock_view_exec_t aetheri_unlock_pam_t aetheri_lock_pixels_t))
(typeattributeset exec_type (aetheri_lock_view_exec_t))
(typeattributeset entry_type (aetheri_lock_view_exec_t))
(call aetheri_app_entry (aetheri_session_t aetheri_lock_view_t aetheri_lock_view_exec_t))

; Startup observes the files in its two admitted views.
(allow aetheri_login_startup_t aetheri_lock_view_exec_t (file (read open getattr)))
(allow aetheri_login_startup_t aetheri_unlock_pam_t (file (read open getattr)))
(allow aetheri_login_startup_t aetheri_greeter_assets_t (file (read open getattr)))
(neverallow aetheri_login_startup_t aetheri_lock_view_exec_t (file (execute execute_no_trans write create unlink)))
(neverallow aetheri_login_startup_t aetheri_unlock_pam_t (file (write create unlink)))
(allow aetheri_login_worker_t aetheri_unlock_pam_t (file (read open getattr)))
(neverallow aetheri_login_worker_t aetheri_unlock_pam_t (file (write create unlink)))

; The root worker owns both ends of the unnamed authority socketpair.
; Linux mediates Unix seqpacket sockets with the Unix stream class.
(allow aetheri_session_t aetheri_login_worker_t (unix_stream_socket (read write getattr getopt)))
(neverallow aetheri_session_t aetheri_login_worker_t (unix_stream_socket (connectto bind listen accept)))
(allow aetheri_login_worker_t aetheri_session_t (fd (use)))
(allow aetheri_login_worker_t self (process (sigkill)))
(allow aetheri_login_worker_t self (fifo_file (create read write open getattr)))

; The desktop owns both inherited view sockets. The view consumes the
; Wayland keymap and passes its private pixel storage to the compositor.
(allow aetheri_lock_view_t aetheri_session_t (unix_stream_socket (read write getattr getopt setopt)))
(allow aetheri_lock_view_t aetheri_session_t (fifo_file (write append getattr ioctl)))
(allow aetheri_session_t aetheri_lock_view_t (fd (use)))
(allow aetheri_lock_view_t aetheri_session_shm_t (file (read getattr map)))
(neverallow aetheri_lock_view_t aetheri_session_shm_t (file (open write)))
(allow aetheri_lock_view_t aetheri_login_shm_dir_t (dir (search getattr add_name write)))
(typetransition aetheri_lock_view_t aetheri_login_shm_dir_t file aetheri_lock_pixels_t)
(allow aetheri_lock_pixels_t tmpfs_t (filesystem (associate)))
(allow aetheri_lock_view_t aetheri_lock_pixels_t (file (create read write open getattr setattr map)))
(allow aetheri_session_t aetheri_lock_pixels_t (file (read write getattr map)))

(allow aetheri_lock_view_t self (process (getattr getsched)))
(allow aetheri_lock_view_t self (fd (use)))
(allow aetheri_lock_view_t self (dir (search getattr)))
(allow aetheri_lock_view_t self (file (read open getattr)))
(allow aetheri_lock_view_t self (lnk_file (read getattr)))
(allow aetheri_lock_view_t pidfs_t (filesystem (getattr)))
(allow aetheri_lock_view_t root_t (dir (search getattr)))
(allow aetheri_lock_view_t usr_t (dir (search read open getattr)))
(allow aetheri_lock_view_t usr_t (file (read open getattr map)))
(allow aetheri_lock_view_t usr_t (lnk_file (read getattr)))
(allow aetheri_lock_view_t lib_t (dir (search getattr)))
(allow aetheri_lock_view_t lib_t (file (read open getattr execute map)))
(allow aetheri_lock_view_t lib_t (lnk_file (read getattr)))
(allow aetheri_lock_view_t ld_so_t (file (read open getattr execute map)))
(allow aetheri_lock_view_t ld_so_cache_t (file (read open getattr map)))
(allow aetheri_lock_view_t etc_t (dir (search getattr)))
(allow aetheri_lock_view_t etc_t (file (read open getattr)))
(allow aetheri_lock_view_t proc_t (dir (search getattr)))
(allow aetheri_lock_view_t proc_t (file (read open getattr)))
(allow aetheri_lock_view_t device_t (dir (search getattr)))
(allow aetheri_lock_view_t null_device_t (chr_file (read write getattr ioctl)))
(allow aetheri_lock_view_t aetheri_greeter_assets_t (file (read open getattr map)))

(neverallow aetheri_lock_view_t aetheri_session_t (unix_stream_socket (connectto bind listen accept)))
(neverallow aetheri_lock_view_t aetheri_login_worker_t (unix_stream_socket (read write connectto)))
(neverallow aetheri_lock_view_t aetheri_session_t (process (ptrace signal sigkill)))
(neverallow aetheri_lock_view_t shadow_t (file (read open write)))
(neverallow aetheri_lock_view_t aetheri_unlock_pam_t (file (read open write)))
(neverallow aetheri_session_t aetheri_unlock_pam_t (file (read open write)))
(neverallow aetheri_lock_view_t self (process (execmem)))
(neverallow aetheri_lock_view_t self (tcp_socket (create)))
(neverallow aetheri_lock_view_t dri_device_t (chr_file (open read write ioctl)))
(neverallow aetheri_lock_view_t event_device_t (chr_file (open read write ioctl)))
(neverallow aetheri_desktop_apps aetheri_lock_pixels_t (file (open read write map)))
(neverallow aetheri_desktop_apps aetheri_lock_view_exec_t (file (execute execute_no_trans)))
(neverallow aetheri_desktop_apps aetheri_login_worker_t (unix_stream_socket (read write connectto)))

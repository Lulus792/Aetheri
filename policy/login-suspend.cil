; The finite system service observes and holds one original desktop.
(type aetheri_suspend_guard_t)
(type aetheri_suspend_guard_exec_t)
(typeattributeset domain (aetheri_suspend_guard_t))
(typeattributeset file_type (aetheri_suspend_guard_exec_t))
(typeattributeset exec_type (aetheri_suspend_guard_exec_t))
(typeattributeset entry_type (aetheri_suspend_guard_exec_t))
(roletype system_r aetheri_suspend_guard_t)

(allow init_t aetheri_suspend_guard_t (process (transition signal sigkill)))
(allow init_t aetheri_suspend_guard_t (process2 (nnp_transition)))
(allow init_t aetheri_suspend_guard_exec_t (file (read open getattr execute map)))
(allow aetheri_suspend_guard_t aetheri_suspend_guard_exec_t (file (entrypoint read open getattr execute map)))
(allow aetheri_suspend_guard_t init_t (fd (use)))
(allow aetheri_suspend_guard_t init_t (process (sigchld)))
(allow aetheri_suspend_guard_t init_t (unix_stream_socket (write getattr ioctl)))
(allow aetheri_suspend_guard_t init_t (fifo_file (write append getattr ioctl)))
(allow aetheri_suspend_guard_t init_t (unix_dgram_socket (sendto)))
(allow aetheri_suspend_guard_t init_var_run_t (dir (search getattr)))
(allow aetheri_suspend_guard_t init_var_run_t (sock_file (write)))
(allow aetheri_suspend_guard_t self (unix_dgram_socket (create connect write getattr getopt setopt sendto)))

(allow aetheri_suspend_guard_t aetheri_session_t (unix_stream_socket (connectto read write getattr getopt setopt)))
(allow aetheri_suspend_guard_t self (unix_stream_socket (create connect read write getattr getopt setopt)))
(allow aetheri_suspend_guard_t aetheri_session_t (fd (use)))
(allow aetheri_session_t aetheri_suspend_guard_t (fd (use)))
(neverallow aetheri_session_t aetheri_suspend_guard_t (unix_stream_socket (connectto)))
(neverallow aetheri_desktop_apps aetheri_suspend_guard_t (unix_stream_socket (connectto read write)))
(neverallow aetheri_lock_view_t aetheri_suspend_guard_t (unix_stream_socket (connectto read write)))
(neverallow aetheri_desktop_apps aetheri_suspend_guard_exec_t (file (execute execute_no_trans)))

(allow aetheri_suspend_guard_t self (process (getattr getcap)))
(allow aetheri_suspend_guard_t self (dir (search getattr)))
(allow aetheri_suspend_guard_t self (file (read open getattr)))
(allow aetheri_suspend_guard_t self (lnk_file (read getattr)))
(allow aetheri_suspend_guard_t root_t (dir (search getattr)))
(allow aetheri_suspend_guard_t usr_t (dir (search getattr)))
(allow aetheri_suspend_guard_t bin_t (dir (search getattr)))
(allow aetheri_suspend_guard_t etc_t (dir (search getattr)))
(allow aetheri_suspend_guard_t lib_t (dir (search getattr)))
(allow aetheri_suspend_guard_t lib_t (file (read open getattr execute map)))
(allow aetheri_suspend_guard_t lib_t (lnk_file (read getattr)))
(allow aetheri_suspend_guard_t ld_so_t (file (read open getattr execute map)))
(allow aetheri_suspend_guard_t ld_so_cache_t (file (read open getattr map)))
(allow aetheri_suspend_guard_t device_t (dir (search getattr)))
(allow aetheri_suspend_guard_t null_device_t (chr_file (read write getattr)))
(allow aetheri_suspend_guard_t proc_t (dir (search getattr)))
(allow aetheri_suspend_guard_t proc_t (file (read open getattr)))
(allow aetheri_suspend_guard_t init_t (dir (search getattr)))
(allow aetheri_suspend_guard_t init_t (file (read open getattr)))
(allow aetheri_suspend_guard_t aetheri_session_t (dir (search getattr)))
(allow aetheri_suspend_guard_t aetheri_session_t (file (read open getattr)))
(allow aetheri_suspend_guard_t aetheri_session_t (process (getattr)))
(allow aetheri_suspend_guard_t pidfs_t (filesystem (getattr)))
(allow aetheri_suspend_guard_t sysfs_t (dir (search getattr)))
(allow aetheri_suspend_guard_t security_t (dir (search getattr)))
(allow aetheri_suspend_guard_t security_t (file (read open getattr)))
(allow aetheri_suspend_guard_t var_run_t (dir (search getattr)))
(allow aetheri_suspend_guard_t systemd_logind_var_run_t (dir (search getattr)))
(allow aetheri_suspend_guard_t systemd_logind_var_run_t (file (read open getattr)))
(allow aetheri_suspend_guard_t systemd_logind_sessions_t (dir (search getattr)))
(allow aetheri_suspend_guard_t systemd_logind_sessions_t (file (read open getattr)))

; The finite login startup observes the same signed guard and suspend files.
(allow aetheri_login_startup_t aetheri_suspend_guard_exec_t (file (read open getattr)))
(allow aetheri_login_startup_t power_unit_file_t (file (read open getattr)))
(allow aetheri_login_startup_t systemd_sleep_exec_t (file (read open getattr)))
(neverallow aetheri_login_startup_t aetheri_suspend_guard_exec_t (file (execute execute_no_trans write create unlink)))
(neverallow aetheri_login_startup_t systemd_sleep_exec_t (file (execute execute_no_trans write create unlink)))

(neverallow aetheri_suspend_guard_t aetheri_session_t (process (ptrace signal sigkill)))
(neverallow aetheri_suspend_guard_t init_t (process (ptrace signal sigkill)))
(neverallow aetheri_suspend_guard_t init_t (file (write append create unlink)))
(neverallow aetheri_suspend_guard_t systemd_logind_var_run_t (file (write append create unlink)))
(neverallow aetheri_suspend_guard_t shadow_t (file (open read write)))
(neverallow aetheri_suspend_guard_t sysfs_t (file (write append)))
(neverallow aetheri_suspend_guard_t self (tcp_socket (create)))

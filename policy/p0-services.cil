; MIT. P0 authority/bootstrap policy, not final launcher or daily-use policy.
(type aetheri_system_t)
(type aetheri_user_t)
(type aetheri_app_t)
(typeattribute aetheri_authority)
(typeattributeset aetheri_authority (aetheri_system_t aetheri_user_t))
(typeattribute aetheri_process)
(typeattributeset aetheri_process (aetheri_system_t aetheri_user_t aetheri_app_t))
(typeattributeset domain (aetheri_system_t aetheri_user_t aetheri_app_t))
(typeattributeset mcs_constrained_type (aetheri_app_t))
(roletype system_r aetheri_system_t)
(roletype system_r aetheri_user_t)
(roletype system_r aetheri_app_t)
(type aetheri_system_exec_t)
(type aetheri_user_exec_t)
(type aetheri_app_exec_t)
(type aetheri_root_t)
(type aetheri_registry_t)
(type aetheri_bus_mount_t)
(type aetheri_system_state_t)
(type aetheri_user_state_t)
(type aetheri_app_data_t)
(type aetheri_system_service_t)
(type aetheri_user_service_t)
(roletype object_r aetheri_system_service_t)
(roletype object_r aetheri_user_service_t)
(typeattributeset file_type (aetheri_system_exec_t aetheri_user_exec_t aetheri_app_exec_t aetheri_root_t aetheri_registry_t aetheri_system_state_t aetheri_user_state_t aetheri_app_data_t))
(typeattributeset file_type (aetheri_bus_mount_t))
(typeattributeset exec_type (aetheri_system_exec_t aetheri_user_exec_t aetheri_app_exec_t))
(typeattributeset entry_type (aetheri_system_exec_t aetheri_user_exec_t aetheri_app_exec_t))

(allow init_t aetheri_process (process (transition)))
(allow init_t aetheri_process (process2 (nnp_transition)))
(allow init_t aetheri_system_exec_t (file (read open getattr execute map)))
(allow init_t aetheri_user_exec_t (file (read open getattr execute map)))
(allow init_t aetheri_app_exec_t (file (read open getattr execute map)))
(allow init_t aetheri_system_state_t (dir (mounton)))
(allow init_t aetheri_user_state_t (dir (mounton)))
(allow init_t aetheri_app_data_t (dir (mounton)))
(allow init_t aetheri_bus_mount_t (file (mounton getattr read open)))
(allow aetheri_system_t aetheri_system_exec_t (file (entrypoint execute read open getattr map)))
(allow aetheri_user_t aetheri_user_exec_t (file (entrypoint execute read open getattr map)))
(allow aetheri_app_t aetheri_app_exec_t (file (entrypoint execute read open getattr map)))
(allow aetheri_process init_t (fd (use)))
(allow aetheri_process init_t (process (sigchld)))
(allow aetheri_process self (process (getcap sigchld signal signull)))
(allow aetheri_process self (dir (search getattr)))
(allow aetheri_process self (file (read open getattr)))
(allow aetheri_process self (lnk_file (read getattr)))
(allow aetheri_process proc_t (dir (search getattr)))
(allow aetheri_process proc_t (lnk_file (read)))
(allow aetheri_process root_t (dir (search getattr)))
(allow aetheri_process usr_t (dir (search getattr)))
(allow aetheri_process lib_t (dir (search getattr)))
(allow aetheri_process lib_t (file (read open getattr execute map)))
(allow aetheri_process lib_t (lnk_file (read getattr)))
(allow aetheri_process ld_so_t (file (read open getattr execute map)))
(allow aetheri_process ld_so_cache_t (file (read open getattr map)))
(allow aetheri_process null_device_t (chr_file (read write open getattr ioctl)))
(allow aetheri_process var_t (dir (search getattr)))
(allow aetheri_process var_lib_t (dir (search getattr)))
(allow aetheri_process aetheri_root_t (dir (search getattr)))
(allow aetheri_process var_run_t (dir (search getattr)))
(allow aetheri_process user_tmp_t (dir (search getattr)))
(allow aetheri_process self (unix_stream_socket (create connect read write getattr getopt setopt shutdown)))
(allow aetheri_process unconfined_dbusd_t (unix_stream_socket (connectto)))
(allow aetheri_process session_dbusd_tmp_t (sock_file (write getattr)))
(allow aetheri_process unconfined_dbusd_t (dbus (send_msg)))
(allow unconfined_dbusd_t aetheri_process (dbus (send_msg)))

(allow aetheri_authority aetheri_root_t (dir (read open)))
(allow aetheri_authority aetheri_registry_t (dir (search read open getattr)))
(allow aetheri_authority aetheri_registry_t (file (read open getattr)))
(allow aetheri_authority sysfs_t (dir (search getattr)))
(allow aetheri_authority security_t (dir (search getattr)))
(allow aetheri_authority security_t (file (read open getattr)))
(allow aetheri_authority sysctl_t (dir (search getattr)))
(allow aetheri_authority sysctl_kernel_t (dir (search getattr)))
(allow aetheri_authority sysctl_kernel_t (file (read open getattr)))
(allow aetheri_authority unconfined_dbusd_t (fd (use)))
(allow aetheri_authority unconfined_t (dbus (send_msg)))
(allow unconfined_t aetheri_authority (dbus (send_msg)))
(allow aetheri_authority self (unix_dgram_socket (create connect write getattr getopt setopt)))
(allow aetheri_authority init_t (unix_dgram_socket (sendto)))
(allow aetheri_authority kernel_t (unix_dgram_socket (sendto)))
(allow aetheri_authority init_var_run_t (sock_file (write)))
(allow aetheri_authority init_var_run_t (dir (search getattr)))
(allow aetheri_authority init_t (unix_stream_socket (read write getattr ioctl)))

(allow aetheri_system_t system_dbusd_var_run_t (dir (search getattr)))
(allow aetheri_system_t system_dbusd_var_run_t (sock_file (write getattr)))
(allow aetheri_system_t system_dbusd_t (unix_stream_socket (connectto)))
(allow aetheri_system_t system_dbusd_t (dbus (send_msg)))
(allow system_dbusd_t aetheri_system_t (dbus (send_msg)))
(allow aetheri_system_t system_dbusd_t (fd (use)))
(allow aetheri_system_t init_t (dbus (send_msg)))
(allow init_t aetheri_system_t (dbus (send_msg)))
(allow aetheri_system_t cgroup_t (dir (search read open getattr)))
(allow aetheri_system_t cgroup_t (filesystem (getattr)))
(allow aetheri_system_t init_t (system (status)))
; Broker identity observations, never its private catalogue or process memory.
(allow aetheri_system_t aetheri_user_t (process (getattr)))
(allow aetheri_system_t aetheri_user_t (dir (search getattr)))
(allow aetheri_system_t aetheri_user_t (file (read open getattr)))
(allow aetheri_system_t aetheri_user_t (lnk_file (read getattr)))
; The broker reaches System1; apps still cannot use the raw system bus.
(allow aetheri_user_t system_dbusd_var_run_t (dir (search getattr)))
(allow aetheri_user_t system_dbusd_var_run_t (sock_file (write getattr)))
(allow aetheri_user_t system_dbusd_t (unix_stream_socket (connectto)))
(allow aetheri_user_t system_dbusd_t (dbus (send_msg)))
(allow system_dbusd_t aetheri_user_t (dbus (send_msg)))
(allow aetheri_user_t aetheri_system_t (dbus (send_msg)))
(allow aetheri_system_t aetheri_user_t (dbus (send_msg)))
(allow aetheri_system_t aetheri_system_service_t (dbus (acquire_svc)))
(allow aetheri_user_t aetheri_user_service_t (dbus (acquire_svc)))
(allow aetheri_system_t aetheri_system_state_t (dir (search read open getattr write add_name remove_name)))
(allow aetheri_system_t aetheri_system_state_t (file (read write append open getattr setattr create unlink lock)))
(allow aetheri_user_t aetheri_user_state_t (dir (search read open getattr write add_name remove_name)))
(allow aetheri_user_t aetheri_user_state_t (file (read write append open getattr setattr create unlink lock)))

; Apps can reach the user protocol endpoint, never the raw system authority.
(allow aetheri_app_t aetheri_user_t (dbus (send_msg)))
(allow aetheri_user_t aetheri_app_t (dbus (send_msg)))
(allow aetheri_app_t aetheri_app_data_t (dir (search read getattr write add_name remove_name)))
(allow aetheri_app_t aetheri_app_data_t (file (read write append open getattr create unlink)))
(neverallow aetheri_app_t aetheri_authority (fd (use)))
(neverallow aetheri_app_t aetheri_authority (process (ptrace)))
(neverallow aetheri_app_t aetheri_system_t (dbus (send_msg)))
(neverallow aetheri_app_t aetheri_registry_t (file (read write append open map execute)))
(neverallow aetheri_app_t aetheri_system_state_t (file (read write append open map execute)))
(neverallow aetheri_app_t aetheri_user_state_t (file (read write append open map execute)))
(neverallow aetheri_process self (capability (sys_admin sys_ptrace setuid setgid dac_override dac_read_search)))
(neverallow aetheri_process self (process (setexec setcurrent dyntransition)))

; MIT. Temporary execution-boundary test only. No production domain is changed.
(type aetheri_exec_setup_test_t)
(type aetheri_exec_app_test_t)
(type aetheri_exec_launcher_test_t)
(type aetheri_exec_code_test_t)
(type aetheri_exec_fixture_test_t)
(type aetheri_exec_data_test_t)
(typeattribute aetheri_exec_test_process)
(typeattributeset aetheri_exec_test_process (aetheri_exec_setup_test_t aetheri_exec_app_test_t))
(typeattributeset domain (aetheri_exec_setup_test_t aetheri_exec_app_test_t))
(typeattributeset mcs_constrained_type (aetheri_exec_app_test_t))
(typeattributeset file_type (aetheri_exec_launcher_test_t aetheri_exec_code_test_t aetheri_exec_fixture_test_t aetheri_exec_data_test_t))
(typeattributeset exec_type (aetheri_exec_launcher_test_t aetheri_exec_code_test_t))
(typeattributeset entry_type (aetheri_exec_launcher_test_t aetheri_exec_code_test_t))
(roletype system_r aetheri_exec_setup_test_t)
(roletype system_r aetheri_exec_app_test_t)
(allow init_t aetheri_exec_setup_test_t (process (transition)))
(allow init_t aetheri_exec_setup_test_t (process2 (nnp_transition)))
(allow init_t aetheri_exec_launcher_test_t (file (read open getattr execute map)))
(allow init_t aetheri_exec_data_test_t (dir (mounton)))
(allow aetheri_exec_setup_test_t aetheri_exec_launcher_test_t (file (entrypoint read open getattr execute map)))
(allow aetheri_exec_setup_test_t aetheri_exec_app_test_t (process (transition getattr signal signull)))
; The code view is nosuid as well as NNP. Both MAC transition gates must permit
; only this exact target domain; UID/capability escalation remains prohibited.
(allow aetheri_exec_setup_test_t aetheri_exec_app_test_t (process2 (nnp_transition nosuid_transition)))
(allow aetheri_exec_app_test_t aetheri_exec_code_test_t (file (entrypoint read open getattr execute map)))
(allow aetheri_exec_setup_test_t aetheri_exec_code_test_t (file (read open getattr execute)))
; Parent-owned child observation/signalling only; the child strips both
; SYS_PTRACE and KILL before entering ae_execute_target.
(allow aetheri_exec_setup_test_t self (capability (sys_admin dac_read_search setuid setgid setpcap sys_ptrace kill)))
(allow aetheri_exec_setup_test_t self (process (fork sigchld signal signull getcap setcap setexec setrlimit)))
(allow aetheri_exec_app_test_t self (process (getcap signal signull)))
(allow aetheri_exec_app_test_t aetheri_exec_setup_test_t (process (sigchld)))
(allow aetheri_exec_test_process init_t (fd (use)))
(allow aetheri_exec_test_process init_t (process (sigchld)))
(allow aetheri_exec_test_process init_t (unix_stream_socket (read write getattr ioctl)))
(allow aetheri_exec_setup_test_t self (fifo_file (read write getattr ioctl)))
; Only approved stdio survives exec; the app must be able to write this test pipe.
(allow aetheri_exec_app_test_t aetheri_exec_setup_test_t (fd (use)))
(allow aetheri_exec_app_test_t aetheri_exec_setup_test_t (fifo_file (write getattr)))
(allow aetheri_exec_test_process self (dir (search read open getattr)))
(allow aetheri_exec_test_process self (file (read open getattr)))
(allow aetheri_exec_test_process self (lnk_file (read getattr)))
(allow aetheri_exec_test_process proc_t (dir (search read open getattr)))
(allow aetheri_exec_test_process proc_t (lnk_file (read getattr)))
(allow aetheri_exec_setup_test_t aetheri_exec_app_test_t (dir (search getattr)))
(allow aetheri_exec_setup_test_t aetheri_exec_app_test_t (file (read open getattr)))
(allow aetheri_exec_setup_test_t aetheri_exec_app_test_t (lnk_file (read getattr)))
(allow aetheri_exec_test_process root_t (dir (search getattr)))
(allow aetheri_exec_test_process var_t (dir (search getattr)))
(allow aetheri_exec_test_process var_lib_t (dir (search getattr)))
(allow aetheri_exec_test_process usr_t (dir (search getattr)))
(allow aetheri_exec_test_process lib_t (dir (search getattr)))
(allow aetheri_exec_test_process lib_t (file (read open getattr execute map)))
(allow aetheri_exec_test_process lib_t (lnk_file (read getattr)))
(allow aetheri_exec_test_process ld_so_t (file (read open getattr execute map)))
(allow aetheri_exec_test_process ld_so_cache_t (file (read open getattr map)))
(allow aetheri_exec_test_process null_device_t (chr_file (read write open getattr ioctl)))
(allow aetheri_exec_setup_test_t root_t (dir (mounton)))
(allow aetheri_exec_setup_test_t nsfs_t (file (read open getattr)))
(allow aetheri_exec_setup_test_t fs_t (filesystem (getattr mount remount unmount)))
(allow aetheri_exec_setup_test_t security_t (dir (search getattr)))
(allow aetheri_exec_setup_test_t sysfs_t (dir (search getattr)))
(allow aetheri_exec_setup_test_t security_t (file (read open getattr)))
(allow aetheri_exec_setup_test_t aetheri_exec_fixture_test_t (dir (search read open getattr mounton)))
(allow aetheri_exec_setup_test_t aetheri_exec_data_test_t (dir (search read open getattr)))
(allow aetheri_exec_app_test_t aetheri_exec_data_test_t (dir (search read open getattr write add_name remove_name)))
(allow aetheri_exec_app_test_t aetheri_exec_data_test_t (file (read write append open getattr create unlink)))
(neverallow aetheri_exec_app_test_t aetheri_exec_data_test_t (file (execute map)))
(neverallow aetheri_exec_app_test_t aetheri_exec_setup_test_t (process (ptrace transition dyntransition)))
(neverallow aetheri_exec_app_test_t self (capability (sys_admin sys_ptrace setuid setgid setpcap dac_override dac_read_search)))
(neverallow aetheri_exec_app_test_t self (process (setexec setcurrent dyntransition fork)))
(neverallow aetheri_exec_test_process aetheri_exec_code_test_t (file (write append setattr unlink)))

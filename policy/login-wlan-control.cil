; MIT. Settings can request only the fixed WLAN unit through this controller.
(type aetheri_wlan_control_t)
(type aetheri_wlan_control_exec_t)
(type aetheri_wlan_unit_t)
(typeattributeset domain (aetheri_wlan_control_t))
(typeattributeset file_type (aetheri_wlan_control_exec_t aetheri_wlan_unit_t))
(typeattributeset exec_type (aetheri_wlan_control_exec_t))
(typeattributeset entry_type (aetheri_wlan_control_exec_t))
(typeattributeset systemd_unit_file_type (aetheri_wlan_unit_t))
(call aetheri_app_entry (init_t aetheri_wlan_control_t aetheri_wlan_control_exec_t))

(allow aetheri_wlan_control_t root_t (dir (search getattr)))
(allow aetheri_wlan_control_t usr_t (dir (search getattr)))
(allow aetheri_wlan_control_t var_run_t (dir (search getattr)))
(allow aetheri_wlan_control_t lib_t (dir (search getattr)))
(allow aetheri_wlan_control_t lib_t (lnk_file (read getattr)))
(allow aetheri_wlan_control_t lib_t (file (read open getattr execute map)))
(allow aetheri_wlan_control_t ld_so_t (file (read open getattr execute map)))
(allow aetheri_wlan_control_t ld_so_cache_t (file (read open getattr map)))
(allow aetheri_wlan_control_t security_t (dir (search getattr)))
(allow aetheri_wlan_control_t security_t (file (read open getattr)))
(allow aetheri_wlan_control_t self (dir (search getattr)))
(allow aetheri_wlan_control_t self (file (read open getattr)))
(allow aetheri_wlan_control_t self (fd (use)))
(allow aetheri_wlan_control_t self (process (getattr getcap signull)))
(allow aetheri_wlan_control_t null_device_t (chr_file (read open getattr)))
(allow aetheri_wlan_control_t device_t (dir (search getattr)))
(allow aetheri_wlan_control_t init_t (unix_stream_socket (write getattr ioctl)))

; Pinned caller observations use existing kernel and logind views.
(allow aetheri_wlan_control_t proc_t (dir (search getattr)))
(allow aetheri_wlan_control_t pidfs_t (filesystem (getattr)))
(allow aetheri_wlan_control_t aetheri_settings_t (process (getattr)))
(allow aetheri_wlan_control_t aetheri_settings_t (dir (search getattr)))
(allow aetheri_wlan_control_t aetheri_settings_t (file (read open getattr ioctl)))
(allow aetheri_wlan_control_t aetheri_settings_t (fd (use)))
(allow aetheri_wlan_control_t cgroup_t (dir (search getattr)))
; sd-login resolves session and scope relative to PID 1's cgroup and reads
; logind's exported seat and session records under /run/systemd.
(allow aetheri_wlan_control_t init_t (dir (search)))
(allow aetheri_wlan_control_t init_t (file (read open getattr)))
(allow aetheri_wlan_control_t init_var_run_t (dir (search getattr)))
(allow aetheri_wlan_control_t systemd_logind_var_run_t (dir (search getattr)))
(allow aetheri_wlan_control_t systemd_logind_var_run_t (file (read open getattr)))
(allow aetheri_wlan_control_t systemd_logind_sessions_t (dir (search getattr)))
(allow aetheri_wlan_control_t systemd_logind_sessions_t (file (read open getattr)))
(neverallow aetheri_wlan_control_t init_t (file (write append create unlink)))
(neverallow aetheri_wlan_control_t systemd_logind_var_run_t (file (write append create unlink)))
(neverallow aetheri_wlan_control_t systemd_logind_sessions_t (file (write append create unlink)))
(neverallow aetheri_wlan_control_t init_t (process (ptrace signal sigkill)))

(typeattribute aetheri_wlan_bus_roles)
(typeattributeset aetheri_wlan_bus_roles (aetheri_settings_t aetheri_wlan_control_t))
(allow aetheri_wlan_control_t self (unix_stream_socket (create connect read write getattr getopt setopt shutdown)))
(allow aetheri_wlan_bus_roles system_dbusd_var_run_t (dir (search getattr)))
(allow aetheri_wlan_bus_roles system_dbusd_var_run_t (sock_file (write getattr)))
(allow aetheri_wlan_bus_roles system_dbusd_t (unix_stream_socket (connectto)))
(allow aetheri_wlan_bus_roles system_dbusd_t (dbus (send_msg)))
(allow system_dbusd_t aetheri_wlan_bus_roles (dbus (send_msg)))
(allow aetheri_wlan_bus_roles system_dbusd_t (fd (use)))
(allow aetheri_wlan_control_t system_dbusd_t (dbus (acquire_svc)))
(allow aetheri_settings_t aetheri_wlan_control_t (dbus (send_msg)))
(allow aetheri_wlan_control_t aetheri_settings_t (dbus (send_msg)))

; Only PID 1 and this unit label enter the privileged operation path.
(allow aetheri_wlan_control_t init_t (dbus (send_msg)))
(allow init_t aetheri_wlan_control_t (dbus (send_msg)))
(allow aetheri_wlan_control_t init_t (process (getattr)))
(allow aetheri_wlan_control_t init_t (system (status)))
(allow aetheri_wlan_control_t aetheri_wlan_unit_t (service (status start stop)))
(neverallow aetheri_wlan_control_t init_t (system (start stop reload enable disable)))
(neverallow aetheri_wlan_control_t systemd_unit_file_t (service (start stop reload enable disable)))
(neverallow aetheri_wlan_control_t aetheri_wlan_unit_t (service (reload enable disable)))
(neverallow aetheri_desktop_apps aetheri_wlan_unit_t (service (start stop reload enable disable)))
(neverallow aetheri_document_apps aetheri_wlan_control_t (dbus (send_msg)))
(neverallow aetheri_desktop_apps aetheri_wlan_control_exec_t (file (execute execute_no_trans entrypoint)))
(neverallow aetheri_wlan_control_t aetheri_wlan_t (dbus (send_msg)))
(neverallow aetheri_wlan_control_t self (capability (net_admin net_raw sys_admin sys_ptrace setuid setgid)))
(neverallow aetheri_wlan_control_t shadow_t (file (read open write)))
(neverallow aetheri_wlan_control_t user_home_t (file (read open write)))

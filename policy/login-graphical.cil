; MIT. Graphical greeter role, loaded with login-startup.cil and login.cil.
(type aetheri_greeter_display_t)
(type aetheri_greeter_display_exec_t)
(type aetheri_greeter_render_t)
(type aetheri_greeter_assets_t)
(type aetheri_greeter_shm_dir_t)
(type aetheri_login_shm_dir_t)
(type aetheri_greeter_shm_t)
(type aetheri_greeter_keymap_t)
(typeattributeset domain (aetheri_greeter_display_t))
(typeattributeset file_type (aetheri_greeter_display_exec_t aetheri_greeter_render_t aetheri_greeter_assets_t aetheri_greeter_shm_dir_t aetheri_login_shm_dir_t aetheri_greeter_shm_t aetheri_greeter_keymap_t))
(typeattributeset exec_type (aetheri_greeter_display_exec_t))
(typeattributeset entry_type (aetheri_greeter_display_exec_t))
(roletype system_r aetheri_greeter_display_t)

; Prepare the private render and scratch directory metadata at boot.
(allow systemd_tmpfiles_t aetheri_greeter_render_t (dir (create getattr setattr)))
(allow systemd_tmpfiles_t aetheri_login_shm_dir_t (dir (create getattr setattr)))

; The ordinary greeter executes the protected compositor and observes its
; original pidfd and ELF. The parent can stop its child without ptrace.
(typetransition aetheri_greeter_t aetheri_greeter_display_exec_t process aetheri_greeter_display_t)
(allow aetheri_greeter_t aetheri_greeter_display_exec_t (file (read open getattr execute map)))
(allow aetheri_greeter_t aetheri_greeter_display_t (process (transition getattr siginh rlimitinh signal signull)))
(allow aetheri_greeter_t aetheri_greeter_display_t (process2 (nnp_transition)))
(allow aetheri_greeter_display_t aetheri_greeter_display_exec_t (file (entrypoint read open getattr execute map)))
(allow aetheri_greeter_display_t aetheri_greeter_t (process (sigchld)))
(allow aetheri_greeter_t aetheri_greeter_display_t (dir (search getattr)))
(allow aetheri_greeter_t aetheri_greeter_display_t (file (read open getattr)))
(allow aetheri_greeter_t aetheri_greeter_display_t (lnk_file (read getattr)))
(neverallow aetheri_greeter_t aetheri_greeter_display_t (process (ptrace)))
(neverallow aetheri_greeter_t aetheri_greeter_display_exec_t (file (execute_no_trans write)))

; The inherited control socket and the offered Wayland stream are unnamed.
; The compositor never inherits the CLOEXEC backend connection.
(allow aetheri_greeter_display_t aetheri_greeter_t (fd (use)))
(allow aetheri_greeter_t aetheri_greeter_display_t (fd (use)))
(allow aetheri_greeter_t self (unix_stream_socket (connectto)))
(allow aetheri_greeter_display_t aetheri_greeter_t (unix_stream_socket (read write getattr getopt setopt shutdown)))
(allow aetheri_greeter_t aetheri_greeter_display_t (unix_stream_socket (read write getattr getopt setopt shutdown)))
(allow aetheri_greeter_display_t self (unix_stream_socket (create connect connectto read write getattr getopt setopt shutdown)))
(allow aetheri_greeter_display_t self (process (getattr getcap sigchld signal signull)))
(allow aetheri_greeter_display_t self (dir (search read open getattr)))
(allow aetheri_greeter_display_t self (file (read open getattr)))
(allow aetheri_greeter_display_t self (lnk_file (read getattr)))

; The greeter inspects its own active logind session and reads the selected
; assets. Shared pixels and keymaps have their own types.
(allow aetheri_greeter_t init_t (dir (search)))
(allow aetheri_greeter_t init_t (file (read open getattr)))
(allow aetheri_greeter_t systemd_logind_sessions_t (dir (search read open getattr watch)))
(allow aetheri_greeter_t systemd_logind_sessions_t (file (read open getattr)))
(allow aetheri_greeter_t aetheri_greeter_render_t (dir (search read open getattr)))
(allow aetheri_greeter_t aetheri_greeter_assets_t (file (read open getattr)))
(allow aetheri_greeter_t usr_t (lnk_file (read getattr)))
(allow aetheri_greeter_shm_dir_t tmpfs_t (filesystem (associate)))
(allow aetheri_greeter_shm_t tmpfs_t (filesystem (associate)))
(allow aetheri_greeter_keymap_t tmpfs_t (filesystem (associate)))
(allow aetheri_greeter_t aetheri_greeter_shm_dir_t (dir (search read open getattr add_name remove_name write)))
(allow aetheri_greeter_display_t aetheri_greeter_shm_dir_t (dir (search read open getattr add_name remove_name write)))
(typetransition aetheri_greeter_t aetheri_greeter_shm_dir_t file aetheri_greeter_shm_t)
(typetransition aetheri_greeter_display_t aetheri_greeter_shm_dir_t file aetheri_greeter_keymap_t)
(typetransition aetheri_greeter_t tmpfs_t file aetheri_greeter_shm_t)
(typetransition aetheri_greeter_display_t tmpfs_t file aetheri_greeter_keymap_t)
(allow aetheri_greeter_t aetheri_greeter_shm_t (file (create read write open getattr setattr map unlink)))
; libwayland maps the client-supplied pixel FD MAP_SHARED with read/write.
; The compositor uses the passed FD. Pathname operations remain with the greeter.
(allow aetheri_greeter_display_t aetheri_greeter_shm_t (file (read write getattr map)))
(neverallow aetheri_greeter_display_t aetheri_greeter_shm_t (file (open create unlink)))
(allow aetheri_greeter_display_t aetheri_greeter_keymap_t (file (create read write open getattr setattr map unlink)))
(allow aetheri_greeter_t aetheri_greeter_keymap_t (file (read getattr map)))

; A login service may give both lifetimes a private POSIX shm mount. Use a
; Root-owned sticky directory without listing rights. File transitions keep
; post-login buffers separate from the greeter's pixels and keyboard map.
(allow aetheri_login_shm_dir_t tmpfs_t (filesystem (associate)))
(allow aetheri_greeter_t aetheri_login_shm_dir_t (dir (search getattr add_name remove_name write)))
(allow aetheri_greeter_display_t aetheri_login_shm_dir_t (dir (search getattr add_name remove_name write)))
(allow aetheri_session_t aetheri_login_shm_dir_t (dir (search getattr add_name remove_name write)))
(allow aetheri_desktop_shell_t aetheri_login_shm_dir_t (dir (search getattr add_name remove_name write)))
(typetransition aetheri_greeter_t aetheri_login_shm_dir_t file aetheri_greeter_shm_t)
(typetransition aetheri_greeter_display_t aetheri_login_shm_dir_t file aetheri_greeter_keymap_t)
(typetransition aetheri_session_t aetheri_login_shm_dir_t file aetheri_session_shm_t)
(typetransition aetheri_desktop_shell_t aetheri_login_shm_dir_t file aetheri_session_shm_t)
(neverallow aetheri_greeter_t aetheri_session_shm_t (file (open read write unlink)))
(neverallow aetheri_greeter_display_t aetheri_session_shm_t (file (open read write unlink)))
(neverallow aetheri_session_t aetheri_greeter_shm_t (file (open read write unlink)))
(neverallow aetheri_desktop_shell_t aetheri_greeter_shm_t (file (open read write unlink)))
(neverallow aetheri_session_t aetheri_greeter_keymap_t (file (open read write unlink)))
(neverallow aetheri_desktop_shell_t aetheri_greeter_keymap_t (file (open read write unlink)))

; The selected compositor uses the protected runtime, keyboard tables and
; libinput data. It obtains device descriptors through logind.
(allow aetheri_greeter_display_t root_t (dir (search getattr)))
(allow aetheri_greeter_display_t usr_t (dir (search read open getattr)))
(allow aetheri_greeter_display_t usr_t (file (read open getattr)))
(allow aetheri_greeter_display_t usr_t (lnk_file (read getattr)))
(allow aetheri_greeter_display_t lib_t (dir (search getattr)))
(allow aetheri_greeter_display_t lib_t (file (read open getattr execute map)))
(allow aetheri_greeter_display_t lib_t (lnk_file (read getattr)))
(allow aetheri_greeter_display_t ld_so_t (file (read open getattr execute map)))
(allow aetheri_greeter_display_t ld_so_cache_t (file (read open getattr map)))
(allow aetheri_greeter_display_t etc_t (dir (search getattr)))
(allow aetheri_greeter_display_t etc_t (file (read open getattr)))
(allow aetheri_greeter_display_t proc_t (dir (search read open getattr)))
(allow aetheri_greeter_display_t proc_t (file (read open getattr)))
(allow aetheri_greeter_display_t proc_t (lnk_file (read getattr)))
(allow aetheri_greeter_display_t init_t (dir (search)))
(allow aetheri_greeter_display_t init_t (file (read open getattr)))
(allow aetheri_greeter_display_t var_run_t (dir (search getattr)))
(allow aetheri_greeter_display_t init_var_run_t (dir (search getattr)))
(allow aetheri_greeter_display_t aetheri_greeter_render_t (dir (search read open getattr)))
(allow aetheri_greeter_display_t systemd_logind_sessions_t (dir (search read open getattr)))
(allow aetheri_greeter_display_t systemd_logind_sessions_t (file (read open getattr)))
(allow aetheri_greeter_display_t system_dbusd_var_run_t (dir (search getattr)))
(allow aetheri_greeter_display_t system_dbusd_var_run_t (sock_file (write getattr)))
(allow aetheri_greeter_display_t system_dbusd_t (unix_stream_socket (connectto)))
(allow aetheri_greeter_display_t system_dbusd_t (dbus (send_msg)))
(allow system_dbusd_t aetheri_greeter_display_t (dbus (send_msg)))
(allow aetheri_greeter_display_t system_dbusd_t (fd (use)))
(allow aetheri_greeter_display_t systemd_logind_t (dbus (send_msg)))
(allow systemd_logind_t aetheri_greeter_display_t (dbus (send_msg)))
(allow aetheri_greeter_display_t systemd_logind_t (fd (use)))
(allow aetheri_greeter_display_t device_t (dir (search read open getattr)))
(allow aetheri_greeter_display_t null_device_t (chr_file (read write open getattr)))
(allow aetheri_greeter_display_t udev_var_run_t (dir (search read open getattr)))
(allow aetheri_greeter_display_t udev_var_run_t (file (read open getattr)))
(allow aetheri_greeter_display_t udev_var_run_t (sock_file (getattr)))
(allow aetheri_greeter_display_t sysfs_t (dir (search read open getattr)))
(allow aetheri_greeter_display_t sysfs_t (file (read open getattr)))
(allow aetheri_greeter_display_t sysfs_t (lnk_file (read getattr)))
(allow aetheri_greeter_display_t self (netlink_kobject_uevent_socket (create bind read getattr getopt setopt)))
(allow aetheri_greeter_display_t dri_device_t (chr_file (getattr read write ioctl map)))
(allow aetheri_greeter_display_t event_device_t (chr_file (getattr read write ioctl)))

; Diagnostic journal stream, without changing the worker's TTY permissions.
(allow aetheri_greeter_t syslogd_var_run_t (dir (search getattr)))
(allow aetheri_greeter_t syslogd_var_run_t (sock_file (write getattr)))
(allow aetheri_greeter_t syslogd_t (unix_stream_socket (connectto)))

(neverallow aetheri_greeter_display_t dri_device_t (chr_file (open)))
(neverallow aetheri_greeter_display_t event_device_t (chr_file (open)))
(neverallow aetheri_greeter_display_t aetheri_login_socket_t (sock_file (read write)))
(neverallow aetheri_greeter_display_t aetheri_login_backend_t (unix_stream_socket (connectto read write)))
(neverallow aetheri_greeter_display_t aetheri_login_handoff_t (file (read open write create unlink)))
(neverallow aetheri_greeter_display_t shadow_t (file (read open write)))
(neverallow aetheri_greeter_display_t user_home_t (file (read open write create)))
(neverallow aetheri_greeter_display_t self (tcp_socket (create)))
(neverallow aetheri_greeter_display_t self (udp_socket (create)))
(neverallow aetheri_greeter_display_t self (process (execmem)))
(neverallow aetheri_greeter_display_t aetheri_greeter_t (process (ptrace)))
(neverallow aetheri_greeter_display_t systemd_unit_file_t (service (start stop reload enable disable)))
(neverallow aetheri_greeter_display_t self (capability (chown dac_override dac_read_search setuid setgid kill sys_admin sys_ptrace sys_tty_config)))
(neverallow aetheri_greeter_display_t self (netlink_kobject_uevent_socket (write)))
(neverallow aetheri_greeter_display_t tmpfs_t (file (create write)))
(neverallow aetheri_greeter_t tmpfs_t (file (create write)))

; MIT. Explicit disposable-carrier audio test only, not production app policy.
(type aetheri_audio_graph_test_t)
(type aetheri_audio_policy_test_t)
(type aetheri_audio_control_test_t)
(type aetheri_audio_player_test_t)
(type aetheri_audio_foreign_test_t)
(typeattribute aetheri_audio_actor_test)
(typeattributeset aetheri_audio_actor_test (aetheri_audio_graph_test_t aetheri_audio_policy_test_t aetheri_audio_control_test_t aetheri_audio_player_test_t aetheri_audio_foreign_test_t))
(typeattributeset domain (aetheri_audio_actor_test))
(roletype system_r aetheri_audio_graph_test_t)
(roletype system_r aetheri_audio_policy_test_t)
(roletype system_r aetheri_audio_control_test_t)
(roletype system_r aetheri_audio_player_test_t)
(roletype system_r aetheri_audio_foreign_test_t)

(type aetheri_audio_fixture_test_t)
(type aetheri_audio_library_test_t)
(type aetheri_audio_gateway_test_t)
(type aetheri_audio_graph_exec_test_t)
(type aetheri_audio_policy_exec_test_t)
(type aetheri_audio_control_exec_test_t)
(type aetheri_audio_player_exec_test_t)
(type aetheri_audio_config_test_t)
(type aetheri_audio_run_test_t)
(type aetheri_audio_state_test_t)
(type aetheri_audio_capture_test_t)
(type aetheri_audio_log_test_t)
(type aetheri_audio_secret_test_t)
(type aetheri_audio_graph_mem_test_t)
(type aetheri_audio_policy_mem_test_t)
(type aetheri_audio_control_mem_test_t)
(type aetheri_audio_player_mem_test_t)
(typeattribute aetheri_audio_memory_test)
(typeattributeset aetheri_audio_memory_test (aetheri_audio_graph_mem_test_t aetheri_audio_policy_mem_test_t aetheri_audio_control_mem_test_t aetheri_audio_player_mem_test_t))
(typeattributeset file_type (aetheri_audio_memory_test))
(typeattributeset tmpfsfile (aetheri_audio_memory_test))
; This carrier uses the legacy tmpfs-backed memfd label path (memfd_class=0).
; Scope new anonymous files to their creator role; never grant generic tmpfs I/O.
(typetransition aetheri_audio_graph_test_t tmpfs_t file aetheri_audio_graph_mem_test_t)
(typetransition aetheri_audio_policy_test_t tmpfs_t file aetheri_audio_policy_mem_test_t)
(typetransition aetheri_audio_control_test_t tmpfs_t file aetheri_audio_control_mem_test_t)
(typetransition aetheri_audio_player_test_t tmpfs_t file aetheri_audio_player_mem_test_t)
(allow aetheri_audio_graph_test_t aetheri_audio_graph_mem_test_t (file (create read write open getattr setattr map ioctl)))
(allow aetheri_audio_policy_test_t aetheri_audio_policy_mem_test_t (file (create read write open getattr setattr map ioctl)))
(allow aetheri_audio_control_test_t aetheri_audio_control_mem_test_t (file (create read write open getattr setattr map ioctl)))
(allow aetheri_audio_player_test_t aetheri_audio_player_mem_test_t (file (create read write open getattr setattr map ioctl)))
(typeattribute aetheri_audio_entry_test)
(typeattributeset aetheri_audio_entry_test (aetheri_audio_gateway_test_t aetheri_audio_graph_exec_test_t aetheri_audio_policy_exec_test_t aetheri_audio_control_exec_test_t aetheri_audio_player_exec_test_t))
(typeattributeset file_type (aetheri_audio_fixture_test_t aetheri_audio_library_test_t aetheri_audio_entry_test aetheri_audio_config_test_t aetheri_audio_run_test_t aetheri_audio_state_test_t aetheri_audio_capture_test_t aetheri_audio_log_test_t aetheri_audio_secret_test_t))
(typeattributeset exec_type (aetheri_audio_entry_test))
(typeattributeset entry_type (aetheri_audio_entry_test))

; PID1 creates only the protected, token-named fixture units. No existing
; authority/app domain receives new permissions, nor any actor a capability.
(allow init_t aetheri_audio_actor_test (process (transition)))
(allow init_t aetheri_audio_actor_test (process2 (nnp_transition)))
(allow init_t aetheri_audio_entry_test (file (read open getattr execute map)))
(allow init_t aetheri_audio_fixture_test_t (dir (search getattr)))
(allow init_t aetheri_audio_log_test_t (file (read write open getattr)))
(allow system_dbusd_t aetheri_audio_log_test_t (file (read write getattr)))
(allow aetheri_audio_actor_test aetheri_audio_gateway_test_t (file (entrypoint execute execute_no_trans read open getattr map)))
(allow aetheri_audio_graph_test_t aetheri_audio_graph_exec_test_t (file (execute execute_no_trans read open getattr map)))
(allow aetheri_audio_policy_test_t aetheri_audio_policy_exec_test_t (file (execute execute_no_trans read open getattr map)))
(allow aetheri_audio_control_test_t aetheri_audio_control_exec_test_t (file (execute execute_no_trans read open getattr map)))
(allow aetheri_audio_player_test_t aetheri_audio_player_exec_test_t (file (execute execute_no_trans read open getattr map)))
(allow aetheri_audio_actor_test self (process (fork sigchld signal signull getcap getsched setsched)))
(allow aetheri_audio_actor_test init_t (process (sigchld)))
(allow aetheri_audio_actor_test init_t (fd (use)))
(allow aetheri_audio_actor_test unconfined_t (fd (use)))
(allow aetheri_audio_actor_test aetheri_audio_log_test_t (file (write append getattr ioctl)))
(allow aetheri_audio_actor_test root_t (dir (search getattr)))
(allow aetheri_audio_actor_test var_t (dir (search getattr)))
(allow aetheri_audio_actor_test var_run_t (dir (search getattr)))
(allow aetheri_audio_actor_test usr_t (dir (search getattr)))
(allow aetheri_audio_actor_test lib_t (dir (search getattr)))
(allow aetheri_audio_actor_test lib_t (file (read open getattr execute map)))
(allow aetheri_audio_actor_test lib_t (lnk_file (read getattr)))
(allow aetheri_audio_actor_test ld_so_t (file (read open getattr execute map)))
(allow aetheri_audio_actor_test ld_so_cache_t (file (read open getattr map)))
(allow aetheri_audio_actor_test aetheri_audio_fixture_test_t (dir (search getattr)))
(allow aetheri_audio_actor_test aetheri_audio_library_test_t (dir (search read open getattr)))
(allow aetheri_audio_actor_test aetheri_audio_library_test_t (file (read open getattr execute map)))
(allow aetheri_audio_actor_test aetheri_audio_library_test_t (lnk_file (read getattr)))
(allow aetheri_audio_actor_test aetheri_audio_config_test_t (dir (search read open getattr)))
(allow aetheri_audio_actor_test aetheri_audio_config_test_t (file (read open getattr map)))
(allow aetheri_audio_actor_test aetheri_audio_config_test_t (lnk_file (read getattr)))
(allow aetheri_audio_actor_test null_device_t (chr_file (read write open getattr ioctl)))
(allow aetheri_audio_actor_test urandom_device_t (chr_file (read open getattr)))
(allow aetheri_audio_actor_test proc_t (dir (search getattr)))
(allow aetheri_audio_actor_test proc_t (lnk_file (read)))
(allow aetheri_audio_actor_test self (dir (search read open getattr)))
(allow aetheri_audio_actor_test self (file (create read write open getattr map ioctl)))
(allow aetheri_audio_actor_test self (lnk_file (read getattr)))
(allow aetheri_audio_actor_test self (unix_stream_socket (create bind listen accept connect read write getattr getopt setopt shutdown)))

; Every actor may traverse the same DAC-accessible socket. The negative actor
; even has sock_file write: its connectto denial must be the peer-domain check.
(allow aetheri_audio_actor_test aetheri_audio_run_test_t (dir (search getattr)))
(allow aetheri_audio_actor_test aetheri_audio_run_test_t (sock_file (write getattr)))
(allow aetheri_audio_graph_test_t aetheri_audio_run_test_t (dir (read open write add_name remove_name)))
(allow aetheri_audio_graph_test_t aetheri_audio_run_test_t (sock_file (create unlink setattr)))
(allow aetheri_audio_graph_test_t aetheri_audio_run_test_t (file (create read write open getattr setattr unlink lock)))
(allow aetheri_audio_graph_test_t self (unix_stream_socket (connectto)))
(allow aetheri_audio_graph_test_t aetheri_audio_capture_test_t (fifo_file (read write open getattr ioctl)))
(allow aetheri_audio_policy_test_t aetheri_audio_state_test_t (dir (search read open getattr create write add_name remove_name rmdir)))
(allow aetheri_audio_policy_test_t aetheri_audio_state_test_t (file (create read write open getattr setattr unlink rename lock)))
(allow aetheri_audio_policy_test_t aetheri_audio_graph_test_t (unix_stream_socket (connectto)))
(allow aetheri_audio_control_test_t aetheri_audio_graph_test_t (unix_stream_socket (connectto)))
(allow aetheri_audio_player_test_t aetheri_audio_graph_test_t (unix_stream_socket (connectto)))

; Native protocol exchanges bounded shared buffers. These are trusted test
; producers/controllers, not an unrestricted graph grant to normal apps.
(typeattribute aetheri_audio_client_test)
(typeattributeset aetheri_audio_client_test (aetheri_audio_policy_test_t aetheri_audio_control_test_t aetheri_audio_player_test_t))
(allow aetheri_audio_client_test aetheri_audio_graph_test_t (fd (use)))
(allow aetheri_audio_client_test aetheri_audio_graph_test_t (file (read write getattr map ioctl)))
(allow aetheri_audio_client_test aetheri_audio_graph_mem_test_t (file (read write getattr map ioctl)))
(allow aetheri_audio_graph_test_t aetheri_audio_client_test (fd (use)))
(allow aetheri_audio_graph_test_t aetheri_audio_client_test (file (read write getattr map ioctl)))
(allow aetheri_audio_graph_test_t aetheri_audio_policy_mem_test_t (file (read write getattr map ioctl)))
(allow aetheri_audio_graph_test_t aetheri_audio_control_mem_test_t (file (read write getattr map ioctl)))
(allow aetheri_audio_graph_test_t aetheri_audio_player_mem_test_t (file (read write getattr map ioctl)))
(allow aetheri_audio_client_test aetheri_audio_graph_test_t (process (getattr)))

(neverallow aetheri_audio_foreign_test_t aetheri_audio_graph_test_t (unix_stream_socket (connectto)))
(neverallow aetheri_audio_foreign_test_t aetheri_audio_memory_test (file (read write open map ioctl)))
(neverallow aetheri_audio_actor_test tmpfs_t (file (write map)))
(neverallow aetheri_audio_actor_test aetheri_audio_secret_test_t (file (read write open map execute)))
(neverallow aetheri_audio_actor_test self (capability (sys_admin sys_ptrace setuid setgid dac_override dac_read_search)))
(neverallow aetheri_audio_actor_test unconfined_t (process (ptrace)))
(neverallow aetheri_audio_actor_test init_t (process (ptrace)))
(neverallow aetheri_audio_actor_test self (tcp_socket (create connect)))
(neverallow aetheri_audio_actor_test bin_t (file (execute execute_no_trans entrypoint)))
(neverallow aetheri_audio_actor_test aetheri_audio_state_test_t (file (execute execute_no_trans entrypoint)))

; MIT. Candidate finite login publisher policy, not the complete login policy.
; Deployment admits the backend by filling the otherwise empty peer attribute.
; The carrier supplement selects its administrative backend only for testing.
(type aetheri_login_startup_t)
(type aetheri_login_startup_exec_t)
(type aetheri_login_runtime_t)
(type aetheri_login_handoff_t)
(typeattribute aetheri_login_observed_backend)
(expandtypeattribute (aetheri_login_observed_backend) false)
(typeattributeset domain (aetheri_login_startup_t))
(typeattributeset file_type (aetheri_login_startup_exec_t aetheri_login_runtime_t aetheri_login_handoff_t))
(typeattributeset exec_type (aetheri_login_startup_exec_t))
(typeattributeset entry_type (aetheri_login_startup_exec_t))
(roletype system_r aetheri_login_startup_t)

(allow init_t aetheri_login_startup_t (process (transition)))
(allow init_t aetheri_login_startup_t (process2 (nnp_transition)))
(allow init_t aetheri_login_startup_exec_t (file (read open getattr execute map)))
(allow init_t aetheri_login_runtime_t (dir (mounton)))
(allow aetheri_login_startup_t aetheri_login_startup_exec_t (file (entrypoint execute read open getattr map)))
(allow aetheri_login_startup_t init_t (fd (use)))
(allow aetheri_login_startup_t init_t (process (sigchld getattr)))
(allow aetheri_login_startup_t init_t (dir (search getattr)))
(allow aetheri_login_startup_t init_t (file (read open getattr)))
(allow aetheri_login_startup_t init_t (lnk_file (read getattr)))
(allow aetheri_login_startup_t self (process (getcap getattr sigchld signal signull)))
(allow aetheri_login_startup_t self (dir (search read open getattr)))
(allow aetheri_login_startup_t self (file (read open getattr)))
(allow aetheri_login_startup_t self (lnk_file (read getattr)))
(allow aetheri_login_startup_t self (capability (dac_override dac_read_search sys_admin sys_chroot sys_ptrace)))

; Read-only image/configuration, proc, cgroup and SELinux observations.
(allow aetheri_login_startup_t root_t (dir (search read open getattr)))
(allow aetheri_login_startup_t usr_t (dir (search read open getattr)))
(allow aetheri_login_startup_t var_t (dir (search getattr)))
(allow aetheri_login_startup_t var_run_t (dir (search read open getattr)))
(allow aetheri_login_startup_t init_var_run_t (dir (search read open getattr)))
(allow aetheri_login_startup_t etc_t (dir (search getattr)))
(allow aetheri_login_startup_t etc_t (file (read open getattr)))
(allow aetheri_login_startup_t bin_t (file (read open getattr)))
(allow aetheri_login_startup_t lib_t (dir (search read open getattr)))
(allow aetheri_login_startup_t lib_t (file (read open getattr execute map)))
(allow aetheri_login_startup_t lib_t (lnk_file (read getattr)))
(allow aetheri_login_startup_t ld_so_t (file (read open getattr execute map)))
(allow aetheri_login_startup_t ld_so_cache_t (file (read open getattr map)))
(allow aetheri_login_startup_t systemd_unit_file_t (dir (search read open getattr)))
(allow aetheri_login_startup_t systemd_unit_file_t (file (read open getattr)))
(allow aetheri_login_startup_t proc_t (dir (search read open getattr)))
(allow aetheri_login_startup_t proc_t (file (read open getattr)))
(allow aetheri_login_startup_t proc_t (lnk_file (read getattr)))
(allow aetheri_login_startup_t sysctl_t (dir (search getattr)))
(allow aetheri_login_startup_t sysctl_kernel_t (dir (search getattr)))
(allow aetheri_login_startup_t sysctl_kernel_t (file (read open getattr)))
(allow aetheri_login_startup_t sysfs_t (dir (search getattr)))
(allow aetheri_login_startup_t security_t (dir (search getattr)))
(allow aetheri_login_startup_t security_t (file (read open getattr)))
(allow aetheri_login_startup_t cgroup_t (dir (search read open getattr)))
(allow aetheri_login_startup_t cgroup_t (filesystem (getattr)))
(allow aetheri_login_startup_t fs_t (filesystem (getattr)))
(allow aetheri_login_startup_t nsfs_t (file (read open getattr ioctl)))
(allow aetheri_login_startup_t nsfs_t (filesystem (getattr)))
(allow aetheri_login_startup_t pidfs_t (filesystem (getattr)))
(allow aetheri_login_startup_t tmpfs_t (filesystem (getattr)))

; No manager mutation or credential protocol. Only selected peer observation,
; its original namespace and the existing host system bus.
(allow aetheri_login_startup_t aetheri_login_observed_backend (process (getattr)))
(allow aetheri_login_startup_t aetheri_login_observed_backend (dir (search getattr)))
(allow aetheri_login_startup_t aetheri_login_observed_backend (file (read open getattr ioctl)))
(allow aetheri_login_startup_t aetheri_login_observed_backend (lnk_file (read getattr)))
(allow aetheri_login_startup_t aetheri_login_observed_backend (fd (use)))
(allow aetheri_login_startup_t aetheri_login_observed_backend (unix_stream_socket (connectto)))
(allow aetheri_login_startup_t self (unix_stream_socket (create connect read write getattr getopt setopt shutdown)))
(allow aetheri_login_startup_t var_run_t (sock_file (write getattr)))
(allow aetheri_login_startup_t system_dbusd_var_run_t (dir (search getattr)))
(allow aetheri_login_startup_t system_dbusd_var_run_t (sock_file (write getattr)))
(allow aetheri_login_startup_t system_dbusd_t (unix_stream_socket (connectto)))
(allow aetheri_login_startup_t system_dbusd_t (dbus (send_msg)))
(allow system_dbusd_t aetheri_login_startup_t (dbus (send_msg)))
(allow aetheri_login_startup_t system_dbusd_t (fd (use)))
(allow aetheri_login_startup_t init_t (dbus (send_msg)))
(allow init_t aetheri_login_startup_t (dbus (send_msg)))
(allow aetheri_login_startup_t init_t (system (status)))
(allow aetheri_login_startup_t systemd_unit_file_t (service (status)))
(allow aetheri_login_startup_t init_t (unix_stream_socket (read write getattr ioctl)))
(allow aetheri_login_startup_t null_device_t (chr_file (read write open getattr ioctl)))

; Publication is confined to its dedicated directory/file types. Existing
; records are never removed; the native create-only protocol owns the lifetime.
(allow aetheri_login_startup_t aetheri_login_runtime_t (dir (search read open getattr write add_name)))
(typetransition aetheri_login_startup_t aetheri_login_runtime_t file aetheri_login_handoff_t)
(allow aetheri_login_startup_t aetheri_login_handoff_t (file (create open read write getattr setattr link relabelfrom relabelto)))
(allow aetheri_login_handoff_t fs_t (filesystem (associate)))
(allow aetheri_login_handoff_t tmpfs_t (filesystem (associate)))

; Compile-time invariants complement actual enforcing denial tests.
(neverallow aetheri_login_startup_t shadow_t (file (read open write)))
(neverallow aetheri_login_startup_t user_home_t (file (read open write create)))
(neverallow aetheri_login_startup_t user_home_dir_t (dir (search write add_name)))
(neverallow aetheri_login_startup_t self (tcp_socket (create)))
(neverallow aetheri_login_startup_t self (udp_socket (create)))
(neverallow aetheri_login_startup_t security_t (security (load_policy setenforce setbool)))
(neverallow aetheri_login_startup_t systemd_unit_file_t (service (start stop reload enable disable)))
(neverallow aetheri_login_startup_t aetheri_login_observed_backend (process (ptrace)))

; MIT. Disposable-carrier compatibility ONLY. Do not ship this supplement.
; PID1 retains an early-boot kernel_t notification socket on this carrier.
; The bounded startup notice still names the exact original MainPID/invocation;
; this type allowance is not socket identity or deployment admission.
(allow aetheri_login_backend_t kernel_t (unix_dgram_socket (sendto)))
; The carrier's pre-policy journal receiver likewise retains kernel_t. PAM's
; ordinary session-open/close messages are not visible without this send right.
(allow aetheri_login_worker_t kernel_t (unix_dgram_socket (sendto)))
; The session and graphical greeter diagnostics use the early-boot journal stream.
(allow aetheri_session_t kernel_t (unix_stream_socket (connectto)))
(allow aetheri_greeter_t kernel_t (unix_stream_socket (connectto)))
; LLVMpipe generates native shader code in this disposable software-rendered
; VM. Only the graphical shell can execute its own generated memory.
(allow aetheri_desktop_shell_t self (process (execmem)))

; Sealed descriptor for one synthetic password in the disposable VM.
; PID1 opens it and the test greeter inherits it through the original worker.
(type aetheri_login_test_input_t)
(typeattributeset file_type (aetheri_login_test_input_t))
(allow aetheri_login_test_input_t tmpfs_t (filesystem (associate)))
(allow init_t aetheri_login_test_input_t (file (read open getattr)))
(allow aetheri_login_roles aetheri_login_test_input_t (file (read getattr ioctl)))

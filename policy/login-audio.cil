; MIT. Audio for the installed authenticated desktop session.
(type aetheri_audio_graph_t)
(type aetheri_audio_policy_t)
(type aetheri_audio_tone_t)
(type aetheri_audio_graph_exec_t)
(type aetheri_audio_policy_exec_t)
(type aetheri_audio_tone_exec_t)
(type aetheri_audio_config_t)
(type aetheri_audio_runtime_t)
(type aetheri_audio_state_t)
(type aetheri_audio_socket_t)
(type aetheri_audio_lock_t)
(type aetheri_audio_graph_mem_t)
(type aetheri_audio_policy_mem_t)
(type aetheri_audio_tone_mem_t)
(typeattribute aetheri_audio_roles)
(typeattribute aetheri_audio_programs)
(typeattributeset aetheri_audio_roles (aetheri_audio_graph_t aetheri_audio_policy_t aetheri_audio_tone_t))
(typeattributeset aetheri_audio_programs (aetheri_audio_graph_exec_t aetheri_audio_policy_exec_t aetheri_audio_tone_exec_t))
(typeattributeset domain (aetheri_audio_roles))
(typeattributeset file_type (aetheri_audio_programs aetheri_audio_config_t aetheri_audio_runtime_t
    aetheri_audio_state_t aetheri_audio_socket_t aetheri_audio_lock_t aetheri_audio_graph_mem_t aetheri_audio_policy_mem_t aetheri_audio_tone_mem_t))
(typeattributeset exec_type (aetheri_audio_programs))
(typeattributeset entry_type (aetheri_audio_programs))
(typeattributeset tmpfsfile (aetheri_audio_graph_mem_t aetheri_audio_policy_mem_t aetheri_audio_tone_mem_t))

(call aetheri_app_entry (aetheri_session_t aetheri_audio_graph_t aetheri_audio_graph_exec_t))
(call aetheri_app_entry (aetheri_session_t aetheri_audio_policy_t aetheri_audio_policy_exec_t))
(call aetheri_app_entry (aetheri_session_t aetheri_audio_tone_t aetheri_audio_tone_exec_t))

; The existing session owner creates and retains these two directories. The
; graph can publish only its own lock and listener types. WirePlumber owns
; state writes and gets only the client side of that listener.
(typetransition aetheri_session_t aetheri_session_runtime_t dir "audio" aetheri_audio_runtime_t)
(typetransition aetheri_session_t aetheri_audio_runtime_t dir "wireplumber" aetheri_audio_state_t)
(typetransition aetheri_audio_graph_t aetheri_audio_runtime_t sock_file "aetheri-audio" aetheri_audio_socket_t)
(typetransition aetheri_audio_graph_t aetheri_audio_runtime_t file "aetheri-audio.lock" aetheri_audio_lock_t)
(allow aetheri_session_t aetheri_audio_runtime_t (dir (create search getattr write add_name remove_name rmdir)))
(allow aetheri_session_t aetheri_audio_state_t (dir (create search getattr rmdir)))
(allow aetheri_session_t aetheri_audio_socket_t (sock_file (getattr)))
(allow aetheri_audio_roles aetheri_session_runtime_t (dir (search getattr)))
(allow aetheri_audio_roles aetheri_audio_runtime_t (dir (search getattr)))
(allow aetheri_audio_graph_t aetheri_audio_runtime_t (dir (write add_name remove_name)))
(allow aetheri_audio_graph_t aetheri_audio_socket_t (sock_file (create getattr setattr write unlink)))
(allow aetheri_audio_graph_t aetheri_audio_lock_t (file (create read write open getattr setattr unlink lock)))
(allow aetheri_audio_policy_t aetheri_audio_socket_t (sock_file (write getattr)))
(allow aetheri_audio_policy_t aetheri_audio_state_t (dir (search read open getattr write add_name remove_name)))
(allow aetheri_audio_policy_t aetheri_audio_state_t (file (create read write open getattr setattr rename unlink)))

(allow aetheri_audio_roles aetheri_session_t (fifo_file (write append getattr ioctl)))
(allow aetheri_audio_roles self (process (fork getattr getcap sigchld signal signull getsched setsched)))
(allow aetheri_audio_roles self (fd (use)))
(allow aetheri_audio_roles self (dir (search read open getattr)))
(allow aetheri_audio_roles self (file (read open getattr)))
(allow aetheri_audio_roles self (lnk_file (read getattr)))
(allow aetheri_audio_roles self (unix_stream_socket (create bind connect read write getattr getopt setopt shutdown)))
(allow aetheri_audio_graph_t self (unix_stream_socket (listen accept connectto)))
(allow aetheri_audio_policy_t aetheri_audio_graph_t (unix_stream_socket (connectto)))

(allow aetheri_audio_roles root_t (dir (search getattr)))
(allow aetheri_audio_roles var_run_t (dir (search getattr)))
(allow aetheri_audio_roles user_tmp_t (dir (search getattr)))
(allow aetheri_audio_roles usr_t (dir (search getattr)))
(allow aetheri_audio_roles lib_t (dir (search getattr)))
(allow aetheri_audio_roles lib_t (lnk_file (read getattr)))
(allow aetheri_audio_roles lib_t (file (read open getattr execute map)))
(allow aetheri_audio_roles ld_so_t (file (read open getattr execute map)))
(allow aetheri_audio_roles ld_so_cache_t (file (read open getattr map)))
(allow aetheri_audio_roles aetheri_audio_config_t (dir (search read open getattr)))
(allow aetheri_audio_roles aetheri_audio_config_t (file (read open getattr map)))
(allow aetheri_audio_roles aetheri_audio_config_t (lnk_file (read getattr)))
(allow aetheri_audio_roles device_t (dir (search getattr)))
(allow aetheri_audio_roles null_device_t (chr_file (read open getattr)))
(allow aetheri_audio_roles urandom_device_t (chr_file (read open getattr)))

; Shared protocol memory travels only between these two audio roles. The
; selected image uses the tmpfs-backed memfd SELinux policy path.
(typetransition aetheri_audio_graph_t tmpfs_t file aetheri_audio_graph_mem_t)
(typetransition aetheri_audio_policy_t tmpfs_t file aetheri_audio_policy_mem_t)
(allow aetheri_audio_graph_t aetheri_audio_graph_mem_t (file (create read write open getattr setattr map ioctl)))
(allow aetheri_audio_policy_t aetheri_audio_policy_mem_t (file (create read write open getattr setattr map ioctl)))
(allow aetheri_audio_graph_t aetheri_audio_policy_mem_t (file (read write getattr map ioctl)))
(allow aetheri_audio_policy_t aetheri_audio_graph_mem_t (file (read write getattr map ioctl)))
(allow aetheri_audio_graph_t aetheri_audio_policy_t (fd (use)))
(allow aetheri_audio_policy_t aetheri_audio_graph_t (fd (use)))

; The fixed tone client borrows the original graph pidfd from its session owner.
; It shares audio buffers with the graph, with no routing-state or device access.
(allow aetheri_audio_tone_t aetheri_audio_socket_t (sock_file (write getattr)))
(allow aetheri_audio_tone_t aetheri_audio_graph_t (unix_stream_socket (connectto)))
(allow aetheri_audio_tone_t aetheri_audio_graph_t (process (getattr)))
(allow aetheri_audio_tone_t pidfs_t (filesystem (getattr)))
(typetransition aetheri_audio_tone_t tmpfs_t file aetheri_audio_tone_mem_t)
(allow aetheri_audio_tone_t aetheri_audio_tone_mem_t (file (create read write open getattr setattr map ioctl)))
(allow aetheri_audio_tone_t aetheri_audio_graph_mem_t (file (read write getattr map ioctl)))
(allow aetheri_audio_graph_t aetheri_audio_tone_mem_t (file (read write getattr map ioctl)))
(allow aetheri_audio_graph_t aetheri_audio_tone_t (fd (use)))
(allow aetheri_audio_tone_t aetheri_audio_graph_t (fd (use)))

; WirePlumber probes ALSA and applies routes and mixer controls. PipeWire
; opens the ALSA nodes created for those routes. Both remain subject to the
; active user's device permissions and the udev/logind seat ACLs.
(allow aetheri_audio_graph_t sound_device_t (dir (search getattr)))
(allow aetheri_audio_graph_t sound_device_t (chr_file (open read write getattr ioctl map)))
(allow aetheri_audio_policy_t device_t (dir (read watch)))
(allow aetheri_audio_policy_t sound_device_t (dir (search read open getattr)))
(allow aetheri_audio_policy_t sound_device_t (chr_file (open read write getattr ioctl map)))
(allow aetheri_audio_policy_t proc_t (dir (search read open getattr)))
(allow aetheri_audio_policy_t proc_t (file (read open getattr)))
(allow aetheri_audio_policy_t proc_t (lnk_file (read getattr)))
(allow aetheri_audio_policy_t sysfs_t (dir (search read open getattr)))
(allow aetheri_audio_policy_t sysfs_t (file (read open getattr)))
(allow aetheri_audio_policy_t sysfs_t (lnk_file (read getattr)))
(allow aetheri_audio_policy_t udev_var_run_t (dir (search read open getattr)))
(allow aetheri_audio_policy_t udev_var_run_t (file (read open getattr)))
(allow aetheri_audio_policy_t self (netlink_kobject_uevent_socket (create bind read getattr getopt setopt)))

(neverallow aetheri_desktop_apps aetheri_audio_programs (file (execute execute_no_trans write)))
(neverallow aetheri_desktop_apps aetheri_audio_graph_t (unix_stream_socket (connectto)))
(neverallow aetheri_desktop_apps aetheri_audio_socket_t (sock_file (write)))
(neverallow aetheri_desktop_apps sound_device_t (chr_file (open read write ioctl map)))
(neverallow aetheri_audio_tone_t sound_device_t (chr_file (open read write ioctl map)))
(neverallow aetheri_audio_tone_t aetheri_audio_state_t (file (open read write create)))
(neverallow aetheri_audio_graph_t aetheri_audio_state_t (dir (write add_name remove_name)))
(neverallow aetheri_audio_policy_t aetheri_audio_runtime_t (dir (write add_name remove_name)))
(neverallow aetheri_audio_roles aetheri_audio_config_t (file (write create unlink)))
(neverallow aetheri_audio_roles user_home_t (file (read open write execute)))
(neverallow aetheri_audio_roles shadow_t (file (read open write)))
(neverallow aetheri_audio_roles bin_t (file (execute execute_no_trans entrypoint)))
(neverallow aetheri_audio_roles tmpfs_t (file (write map)))
(neverallow aetheri_audio_roles self (process (execmem)))
(neverallow aetheri_audio_roles self (tcp_socket (create connect)))
(neverallow aetheri_audio_roles self (udp_socket (create)))
(neverallow aetheri_audio_roles self (capability (sys_admin sys_ptrace setuid setgid dac_override dac_read_search)))
